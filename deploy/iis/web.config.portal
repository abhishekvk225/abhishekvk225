<?xml version="1.0" encoding="utf-8"?>
<!--
  NexaVerify Blazor portal: web.config for IIS (ASP.NET Core Module V2, in-process). Blazor Server needs WebSockets (install the IIS
  "WebSocket Protocol" feature). No secrets here; see docs/runbooks/iis-deployment.md.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\NexaVerify.Web.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="30">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="NEXAVERIFY_SECRETS_DIR" value="C:\ProgramData\NexaVerify\secrets\portal" />
          <environmentVariable name="DOTNET_EnableDiagnostics" value="0" />
        </environmentVariables>
      </aspNetCore>

      <webSocket enabled="true" />

      <security>
        <requestFiltering removeServerHeader="true">
          <!-- The portal accepts small form posts and the CSV relay only; camera frames travel over the SignalR circuit in chunks. -->
          <requestLimits maxAllowedContentLength="8388608" maxUrl="2048" maxQueryString="2048" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
