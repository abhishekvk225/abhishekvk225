<?xml version="1.0" encoding="utf-8"?>
<!--
  NexaVerify API: web.config for IIS (ASP.NET Core Module V2, in-process hosting). scripts/publish-iis.ps1 copies this over the
  generated file as web.config. It contains NO secrets: put secrets in files under the secrets directory (see docs/runbooks/iis-deployment.md)
  or in machine-level environment variables, never here.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\NexaVerify.Api.dll"
                  hostingModel="inprocess"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="120"
                  shutdownTimeLimit="30">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Directory of secret files (file name = setting name with "__" for ":"). Restrict its ACL to the app pool identity. -->
          <environmentVariable name="NEXAVERIFY_SECRETS_DIR" value="C:\ProgramData\NexaVerify\secrets\api" />
          <environmentVariable name="DOTNET_EnableDiagnostics" value="0" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering removeServerHeader="true">
          <!--
            In-process hosting: IIS enforces this limit, not Kestrel. Keep it equal to RequestLimits:MaxRequestBodyBytes (6 MiB = 6291456):
            a 5 MB image plus multipart overhead fits, everything larger is rejected before it reaches the app.
          -->
          <requestLimits maxAllowedContentLength="6291456" maxUrl="2048" maxQueryString="2048" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
