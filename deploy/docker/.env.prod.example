# Copy to deploy/docker/.env.prod (git-ignored). Non-secret settings only; secrets live in ./secrets/ (see prod/make-secrets.sh).
NEXAVERIFY_REGISTRY=nexaverify
NEXAVERIFY_TAG=0.0.0-local
API_HOST=api.nexaverify.example
PORTAL_HOST=portal.nexaverify.example
SEED_ADMIN_EMAIL=admin@nexaverify.example
MSSQL_PID=Developer
# Demo/rehearsal only (the shipped face engine is a mock). Must stay false in a real production.
ALLOW_MOCK_FACE_ENGINE=false
TELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Email: real production uses EMAIL_PROVIDER=Smtp with SMTP_HOST/SMTP_USERNAME (password via the secrets directory: Email__Smtp__Password).
# ALLOW_LOGGING_EMAIL=true lets a rehearsal stack start without a mail server (mail is only logged). Must stay false in a real production.
EMAIL_PROVIDER=Logging
ALLOW_LOGGING_EMAIL=false
EMAIL_FROM_ADDRESS=no-reply@nexaverify.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
