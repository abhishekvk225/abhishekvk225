{
  "id": "synthetic-layout-a",
  "displayName": "SYNTHETIC test layout A (not a real bank): dd-MMM-yyyy, Dr/Cr suffixes",
  "detectPatterns": ["(?i)synthetic\\s+bank\\s+alpha"],
  "header": {
    "holderName": "(?i)^account\\s+holder\\s*:\\s*(?<v>[A-Za-z][A-Za-z .'\\-]{1,80})$",
    "bankName": "(?i)^(?<v>synthetic\\s+bank\\s+alpha)\\b",
    "accountNumber": "(?i)^account\\s+number\\s*:\\s*(?<v>[0-9Xx*]{6,24})$",
    "periodFrom": "(?i)^statement\\s+period\\s*:\\s*(?<v>\\d{2}-[A-Za-z]{3}-\\d{4})",
    "periodTo": "(?i)^statement\\s+period\\s*:.*?\\bto\\s+(?<v>\\d{2}-[A-Za-z]{3}-\\d{4})",
    "openingBalance": "(?i)^opening\\s+balance\\s*:\\s*(?<v>[\\d,]+\\.\\d{2}\\s?(?:Dr|Cr))",
    "closingBalance": "(?i)^closing\\s+balance\\s*:\\s*(?<v>[\\d,]+\\.\\d{2}\\s?(?:Dr|Cr))"
  },
  "transactions": {
    "lines": [
      "^(?<date>\\d{2}-[A-Za-z]{3}-\\d{4})\\s+(?<desc>.+?)\\s+(?<amount>[\\d,]+\\.\\d{2}\\s?(?:Dr|Cr))\\s+(?<balance>[\\d,]+\\.\\d{2}\\s?(?:Dr|Cr))$"
    ],
    "ignoreLines": ["(?i)^page\\s+\\d+", "(?i)^date\\b", "(?i)^synthetic\\s+bank"]
  },
  "dateFormats": ["dd-MMM-yyyy"],
  "amounts": { "decimalSeparator": ".", "thousandsSeparator": ",", "lakhGrouping": false, "drCrSuffix": true },
  "defaultCurrency": "INR"
}
