{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Jwt": {
    "AllowEphemeralKey": true
  },
  "Auth": {
    "PasswordResetUrlTemplate": "https://localhost/reset-password?email={email}&token={token}"
  },
  "Encryption": {
    "AllowEphemeralKey": true
  }
}
