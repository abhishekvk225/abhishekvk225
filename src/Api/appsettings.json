{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*",
  "Hosting": { "RedirectToHttps": true },
  "SecurityHeaders": {
    "Enabled": true,
    "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=()",
    "HstsMaxAgeSeconds": 31536000
  },
  "Cors": { "AllowedOrigins": [] },
  "RequestLimits": { "MaxRequestBodyBytes": 6291456 },
  "Database": { "CommandTimeoutSeconds": 30 }
}
