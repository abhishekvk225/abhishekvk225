{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Hosting": {
    "RedirectToHttps": true
  },
  "SecurityHeaders": {
    "Enabled": true,
    "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'",
    "ReferrerPolicy": "no-referrer",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=()",
    "HstsMaxAgeSeconds": 31536000
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 6291456,
    "RequestHeadersTimeoutSeconds": 30,
    "MaxRequestHeadersTotalSizeBytes": 32768,
    "MinRequestBodyBytesPerSecond": 240,
    "RequestTimeoutSeconds": 60,
    "JsonMaxDepth": 32
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "RateLimiting": {
    "PerIpPerMinute": 300,
    "AuthPerIpPerMinute": 10
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshTokenSlidingDays": 7,
    "RefreshTokenAbsoluteDays": 30,
    "PasswordResetMinutes": 30,
    "PasswordResetUrlTemplate": "https://portal.example.com/reset-password?email={email}&token={token}"
  },
  "Portal": {
    "PublicBaseUrl": "https://portal.example.com"
  },
  "Signup": {
    "Enabled": true,
    "TrialCredits": 100,
    "TrialDays": 14,
    "VerificationHours": 24,
    "MaxSignupsPerIpPerHour": 5,
    "MaxSignupsPerEmailPerDay": 3,
    "MaxContactsPerIpPerHour": 5,
    "ContactRetentionDays": 180
  },
  "Captcha": {
    "Provider": "none"
  },
  "Mfa": {
    "Enabled": true,
    "RequiredPlatformRoles": "SuperAdmin",
    "AllowClientUsers": true,
    "Issuer": "NexaVerify",
    "ChallengeMinutes": 5,
    "MaxChallengeAttempts": 5,
    "Window": 1,
    "RecoveryCodeCount": 10
  },
  "Licensing": {
    "MaxAdjustPerAction": 10000,
    "AdjustApprovalHours": 24
  },
  "ApiAuth": {
    "CacheSeconds": 5,
    "NegativeCacheEntries": 5000,
    "NegativeCacheSeconds": 5
  },
  "Faces": {
    "Retention": {
      "Enabled": true,
      "HistoryPersonalDataDays": 90,
      "BatchSize": 200,
      "MaxBatchesPerClient": 500
    }
  },
  "PasswordPolicy": {
    "MinLength": 12,
    "MaxLength": 128
  },
  "PasswordHashing": {
    "IterationCount": 210000
  },
  "Jwt": {
    "Issuer": "nexaverify",
    "Audience": "nexaverify-api",
    "AccessTokenMinutes": 15,
    "ClockSkewSeconds": 60,
    "SigningKeyId": "k1",
    "AllowEphemeralKey": false
  }
}
