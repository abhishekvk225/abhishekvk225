{
  "Hosting": {
    "RedirectToHttps": false
  },
  "SecurityHeaders": {
    "HstsMaxAgeSeconds": 0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Jwt": {
    "AllowEphemeralKey": true
  },
  "Email": {
    "LogBodies": true
  },
  "Auth": {
    "PasswordResetUrlTemplate": "https://localhost:7200/reset-password?email={email}&token={token}"
  },
  "Portal": {
    "PublicBaseUrl": "https://localhost:7200"
  },
  "Billing": {
    "Enabled": true,
    "Provider": "Simulated",
    "TaxPercent": 18,
    "TaxLabel": "GST",
    "Seller": {
      "LegalName": "NexaVerify (development)",
      "AddressLines": [ "1 Example Street", "Bengaluru 560001", "India" ],
      "TaxId": "29ABCDE1234F1Z5",
      "TaxIdLabel": "GSTIN",
      "Email": "billing@nexaverify.example"
    }
  },
  "Encryption": {
    "AllowEphemeralKey": true
  },
  "Mfa": {
    "RequiredPlatformRoles": "-"
  }
}
