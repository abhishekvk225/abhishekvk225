@using Microsoft.AspNetCore.Components.Web
@using NexaVerify.Web.Security

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#4338CA" />
    <base href="/" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="@Assets["marketing.css"]" />
    <script nonce="@Nonce" src="@Assets["js/site.js"]"></script>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" ClientIp="@ClientIp" />

    <div id="blazor-error-ui" role="alert">
        An unexpected error occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss" aria-label="Dismiss">✕</span>
    </div>

    <script nonce="@Nonce" src="js/nexa.js"></script>
    <script nonce="@Nonce" src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script nonce="@Nonce" src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // Interactive Server without prerendering: the shell needs browser APIs (theme, storage) before it can render correctly.
    private static readonly IComponentRenderMode InteractiveMode = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The marketing pages and the sign-in page are static server-rendered (no SignalR circuit). The sign-in page is a plain HTML form
    // posting to /auth/login, because only a normal HTTP response can set the session cookie. Everything else is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext is { } http && PublicRoutes.IsStatic(http.Request.Path) ? null : InteractiveMode;

    // The person's address (after trusted-proxy processing), handed to the circuit so its API calls can be attributed and limited per person.
    private string? ClientIp => HttpContext?.Connection.RemoteIpAddress?.ToString();

    private string Nonce => HttpContext.GetCspNonce();
}
