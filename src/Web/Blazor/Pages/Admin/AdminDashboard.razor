@page "/admin"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.DashboardAdmin)]
@implements IDisposable
@inject IDashboardApiClient Api
@inject DashboardRangeState Range
@inject TimeProvider Clock

<PageTitle>Dashboard · Admin · NexaVerify</PageTitle>

<PageHeader Title="Dashboard" Subtitle="Platform health, usage and licenses at a glance.">
    <Actions><RangeSelector /></Actions>
</PageHeader>

<PageState T="AdminDashboardModel" Result="_state.Result" OnRetry="LoadAsync">
    <Loading><DashboardSkeleton Cards="6" /></Loading>
    <ChildContent Context="model">
        <MudGrid Spacing="3">
            @foreach (var kpi in model.Kpis)
            {
                <MudItem xs="12" sm="6" md="4" lg="2">
                    <StatCard Title="@kpi.Title" Value="@kpi.Value" Icon="@kpi.Icon" DeltaPercent="@kpi.DeltaPercent" HigherIsBetter="kpi.HigherIsBetter" Sparkline="@kpi.Sparkline" />
                </MudItem>
            }

            <MudItem xs="12" lg="8">
                <ChartCard Title="API requests" Subtitle="@($"Last {Range.Days} days")" IsEmpty="model.RequestsTrend.Count == 0">
                    <ChildContent><SimpleChart Kind="ChartKind.Line" Series="model.RequestsTrend" Description="@($"Line chart of successful and failed API requests over the last {Range.Days} days.")" /></ChildContent>
                    <TableContent><SeriesTable Series="model.RequestsTrend" Caption="API requests per day" /></TableContent>
                </ChartCard>
            </MudItem>
            <MudItem xs="12" lg="4">
                <ChartCard Title="Client-wise usage" Subtitle="Top clients by billed operations" IsEmpty="model.ClientUsage.Count == 0">
                    <ChildContent><SimpleChart Kind="ChartKind.Bar" Series="ClientSeries(model)" Description="Bar chart of billed operations per client." /></ChildContent>
                    <TableContent><SeriesTable Series="ClientSeries(model)" LabelHeader="Client" Caption="Billed operations per client" /></TableContent>
                </ChartCard>
            </MudItem>

            <MudItem xs="12" lg="6">
                <ChartCard Title="Credits consumed" Subtitle="@($"Last {Range.Days} days")" IsEmpty="model.CreditsTrend.Count == 0">
                    <ChildContent><SimpleChart Kind="ChartKind.Line" Series="model.CreditsTrend" Description="Line chart of credits consumed per day." /></ChildContent>
                    <TableContent><SeriesTable Series="model.CreditsTrend" Caption="Credits consumed per day" /></TableContent>
                </ChartCard>
            </MudItem>
            <MudItem xs="12" lg="6">
                <MudPaper Class="nv-card nv-card-pad" Elevation="0">
                    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">Licenses expiring soon</MudText>
                    <DataTable T="ExpiringLicenseRow" Caption="Licenses expiring soon" Columns="_expiringColumns" LoadData="@(_ => Task.FromResult(InMemory(model.ExpiringLicenses)))" PageSize="10" Dense="true"
                               EmptyMessage="No licenses are close to expiring." />
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudPaper Class="nv-card nv-card-pad" Elevation="0">
                    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">Licenses running low on credits</MudText>
                    <DataTable T="ExpiringLicenseRow" Caption="Licenses running low on credits" Columns="_lowColumns" LoadData="@(_ => Task.FromResult(InMemory(model.LowBalanceLicenses)))" PageSize="10" Dense="true"
                               EmptyMessage="No license is close to running out of credits." />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="5">
                <MudPaper Class="nv-card nv-card-pad" Elevation="0">
                    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">Needs attention</MudText>
                    <AlertList Alerts="model.Alerts" />
                    <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-4 mb-2">Clients by status</MudText>
                    <ul class="ma-0 pa-0" style="list-style:none;display:grid;gap:var(--nv-space-2);" data-testid="clients-by-status">
                        @foreach (var status in model.ClientsByStatus)
                        {
                            <li class="d-flex align-center justify-space-between"><StatusChip Kind="StatusKind.Client" Value="@status.Label" /><span>@UiText.Number(status.Count)</span></li>
                        }
                    </ul>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </ChildContent>
</PageState>

@code {
    private readonly LoadState<AdminDashboardModel> _state = new();
    private IReadOnlyList<DataColumn<ExpiringLicenseRow>> _expiringColumns = [];
    private IReadOnlyList<DataColumn<ExpiringLicenseRow>> _lowColumns = [];

    protected override async Task OnInitializedAsync()
    {
        _expiringColumns =
        [
            DataColumn<ExpiringLicenseRow>.Text("Client", r => r.Client),
            DataColumn<ExpiringLicenseRow>.Text("License", r => r.LicenseNumber),
            DataColumn<ExpiringLicenseRow>.Text("Credits left", r => $"{UiText.Number(r.Remaining)} / {UiText.Number(r.Total)}", numeric: true),
            DataColumn<ExpiringLicenseRow>.Custom("Expires", r => @<span>@UiText.Plural(Math.Max(0, (int)(r.ExpiresAt - Clock.GetUtcNow()).TotalDays), "day")</span>),
        ];
        _lowColumns =
        [
            DataColumn<ExpiringLicenseRow>.Text("Client", r => r.Client),
            DataColumn<ExpiringLicenseRow>.Text("License", r => r.LicenseNumber),
            DataColumn<ExpiringLicenseRow>.Text("Credits left", r => $"{UiText.Number(r.Remaining)} / {UiText.Number(r.Total)}", numeric: true),
        ];
        Range.Changed += OnRangeChanged;
        await LoadAsync();
    }

    private Task LoadAsync() => _state.LoadAsync(ct => Api.GetAdminDashboardAsync(Range.Range, ct));

    private void OnRangeChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            // LoadState never throws for API failures; anything else must not take the circuit down from a fire-and-forget callback.
        }
    });

    private static ApiResult<PagedResult<T>> InMemory<T>(IReadOnlyList<T> rows) =>
        ApiResult<PagedResult<T>>.Ok(new PagedResult<T>(rows, 1, Math.Max(1, rows.Count), rows.Count));

    private static IReadOnlyList<TrendSeries> ClientSeries(AdminDashboardModel m) =>
        [new TrendSeries("Requests", m.ClientUsage.Select(c => new TrendPoint(c.Client, c.Requests)).ToList())];

    public void Dispose()
    {
        Range.Changed -= OnRangeChanged;
        _state.Dispose();
    }
}
