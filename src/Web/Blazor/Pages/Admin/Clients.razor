@page "/admin/clients"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.ClientsRead)]
@inject IClientsApiClient Api

<PageTitle>Clients · Admin · NexaVerify</PageTitle>

<PageHeader Title="Clients" Subtitle="Every company that uses NexaVerify.">
    <Actions>
        <Can Permission="@WebPermissions.ClientsCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Href="admin/clients/new" data-testid="new-client">New client</MudButton>
        </Can>
    </Actions>
</PageHeader>

<MudPaper Class="nv-card" Elevation="0">
    <div class="pa-4">
        <FilterBar SearchLabel="Search clients" SearchPlaceholder="Name, code or email" OnSearch="OnSearch" ExtraFiltersActive="@(_status is not null)" OnReset="ResetStatus">
            <Filters>
                <MudSelect T="string" Value="_status" ValueChanged="OnStatusChanged" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width: 180px;">
                    @foreach (var (value, label) in StatusOptions)
                    {
                        <MudSelectItem T="string" Value="@value">@label</MudSelectItem>
                    }
                </MudSelect>
            </Filters>
        </FilterBar>
    </div>
    <DataTable @key="@(_status ?? "all")" T="ClientListItemDto" Caption="Clients" Columns="_columns" LoadPage="LoadAsync" Search="@_search" DefaultSort="name:asc"
               EmptyMessage="No clients yet. Create the first one to get started.">
        <RowActions Context="client">
            <MudIconButton Icon="@Icons.Material.Outlined.OpenInNew" Href="@($"admin/clients/{client.Id}")" aria-label="@($"Open {client.Name}")" />
        </RowActions>
    </DataTable>
</MudPaper>

@code {
    private static readonly (string Value, string Label)[] StatusOptions =
    [
        ("Active", "Active"), ("PendingActivation", "Pending"), ("Suspended", "Suspended"), ("Inactive", "Inactive"),
    ];

    private IReadOnlyList<DataColumn<ClientListItemDto>> _columns = [];
    private string? _search;
    private string? _status;

    protected override void OnInitialized() =>
        _columns =
        [
            DataColumn<ClientListItemDto>.Custom("Client", c => @<MudLink Href="@($"admin/clients/{c.Id}")" Underline="Underline.Hover">@c.Name</MudLink>, "name"),
            DataColumn<ClientListItemDto>.Text("Code", c => c.Code, "code"),
            DataColumn<ClientListItemDto>.Text("Contact", c => c.ContactEmail),
            DataColumn<ClientListItemDto>.Custom("Status", c => @<StatusChip Kind="StatusKind.Client" Value="@c.Status" />),
            DataColumn<ClientListItemDto>.Text("Users", c => c.UserCount.ToString(System.Globalization.CultureInfo.InvariantCulture), numeric: true),
            DataColumn<ClientListItemDto>.Text("Created", c => c.CreatedAt.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture), "createdAt"),
        ];

    private Task<ApiResult<PagedResult<ClientListItemDto>>> LoadAsync(PageRequest page, CancellationToken ct) => Api.ListAsync(page, _status, ct);

    private void OnSearch(string? text) => _search = text;

    private void OnStatusChanged(string? status) => _status = status;

    private void ResetStatus() => _status = null;
}
