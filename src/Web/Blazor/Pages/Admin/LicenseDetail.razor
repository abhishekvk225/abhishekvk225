@page "/admin/licenses/{Id:guid}"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.LicensesRead)]
@inject ILicensingApiClient Api
@inject IDialogService Dialogs
@inject IAppSnackbar Snackbar
@implements IDisposable

<PageTitle>@(_state.Result is { IsSuccess: true } r ? r.Value.Name : "License") · Admin · NexaVerify</PageTitle>

<PageState T="LicenseDto" Result="_state.Result" OnRetry="ReloadAsync">
    <Loading><SkeletonCard Lines="4" /></Loading>
    <ChildContent Context="license">
        <PageHeader Title="@license.Name" Subtitle="@($"License of {license.ClientName}")" Breadcrumbs="Crumbs(license)">
            <Actions>
                <StatusChip Kind="StatusKind.License" Value="@license.EffectiveStatus" />
                <Can Permission="@WebPermissions.LicensesUpdate">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => RenameAsync(license)" data-testid="edit-license">Edit</MudButton>
                </Can>
                <Can Permission="@WebPermissions.LicensesRenew">
                    @if (license.Status is not "Revoked")
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Autorenew" OnClick="() => RenewAsync(license)" data-testid="renew-license">Renew</MudButton>
                    }
                </Can>
                <Can Permission="@WebPermissions.LicensesAdjust">
                    @if (license.Status is not "Revoked")
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Toll" OnClick="() => AdjustAsync(license)" data-testid="adjust-license">Adjust credits</MudButton>
                    }
                </Can>
                <Can Permission="@WebPermissions.LicensesManageStatus">
                    @if (license.Status is "Draft" or "Inactive" or "Suspended")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Outlined.PlayCircle" OnClick="() => ActivateAsync(license)" data-testid="activate-license">Activate</MudButton>
                    }
                    @if (license.Status is "Active")
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.PauseCircle" OnClick="() => SuspendAsync(license)" data-testid="suspend-license">Suspend</MudButton>
                    }
                    @if (license.Status is not "Revoked")
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Block" OnClick="() => RevokeAsync(license)" data-testid="revoke-license">Revoke</MudButton>
                    }
                </Can>
            </Actions>
        </PageHeader>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="5">
                <MudPaper Class="nv-card nv-card-pad" Elevation="0" Style="height: 100%;">
                    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-4">Credits</MudText>
                    <LicenseGauge Remaining="license.RemainingCredits" Total="license.TotalCredits" ExpiresAt="@(new DateTimeOffset(DateTime.SpecifyKind(license.ExpiresAt, DateTimeKind.Utc)))" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" lg="7">
                <MudPaper Class="nv-card nv-card-pad" Elevation="0" Style="height: 100%;">
                    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">Details</MudText>
                    <DetailList Items="DetailItems(license)" />
                </MudPaper>
            </MudItem>

            <MudItem xs="12">
                <MudPaper Class="nv-card" Elevation="0">
                    <div class="d-flex flex-wrap align-center justify-space-between pa-4" style="gap: var(--nv-space-3);">
                        <MudText Typo="Typo.h5" HtmlTag="h2">Credit ledger</MudText>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.VerifiedUser" OnClick="VerifyAsync" Disabled="_verifying" data-testid="verify-license-ledger">
                            @(_verifying ? "Checking…" : "Check ledger integrity")
                        </MudButton>
                    </div>
                    @if (_verification is not null)
                    {
                        <div class="px-4 pb-3" aria-live="polite" data-testid="ledger-result">
                            @if (_verification.Valid)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Variant="Variant.Outlined">The ledger is intact: @UiText.Number(_verification.Entries) entries, balance and hash chain agree.</MudAlert>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">
                                    The ledger failed its integrity check.
                                    <ul class="ma-0">
                                        @foreach (var problem in _verification.Problems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                </MudAlert>
                            }
                        </div>
                    }
                    <DataTable @ref="_ledger" T="LicenseTransactionDto" Caption="Credit ledger" Columns="_columns" LoadPage="(p, ct) => Api.GetTransactionsAsync(license.Id, p, ct)" PageSize="25" DefaultSort="createdAt:desc"
                               EmptyMessage="No credit movements yet.">
                        <RowActions Context="tx">
                            <Can Permission="@WebPermissions.LicensesAdjust">
                                @if (tx.Type is "Consume")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => RefundAsync(tx)" aria-label="@($"Refund transaction {tx.Id}")">Refund</MudButton>
                                }
                            </Can>
                        </RowActions>
                    </DataTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </ChildContent>
</PageState>

@code {
    private readonly LoadState<LicenseDto> _state = new();
    private Guid? _loadedId;
    private DataTable<LicenseTransactionDto>? _ledger;
    private LedgerVerificationDto? _verification;
    private IReadOnlyList<DataColumn<LicenseTransactionDto>> _columns = [];
    private bool _verifying;

    [Parameter] public Guid Id { get; set; }

    protected override void OnInitialized() =>
        _columns =
        [
            DataColumn<LicenseTransactionDto>.Text("When (UTC)", t => t.CreatedAt.ToString("d MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture)),
            DataColumn<LicenseTransactionDto>.Text("Type", t => t.Type),
            DataColumn<LicenseTransactionDto>.Text("Credits", t => t.Credits > 0 ? $"+{UiText.Number(t.Credits)}" : UiText.Number(t.Credits), numeric: true),
            DataColumn<LicenseTransactionDto>.Text("Balance after", t => UiText.Number(t.BalanceAfter), numeric: true),
            DataColumn<LicenseTransactionDto>.Text("Operation", t => t.Operation),
            DataColumn<LicenseTransactionDto>.Text("Reason", t => t.Reason),
            DataColumn<LicenseTransactionDto>.Text("By", t => t.ActorType),
        ];

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return;
        }

        _loadedId = Id;
        _verification = null;
        await _state.LoadAsync(ct => Api.GetAsync(Id, ct));
    }

    private Task ReloadAsync() => _state.LoadAsync(ct => Api.GetAsync(Id, ct));

    public void Dispose() => _state.Dispose();

    private static List<BreadcrumbItem> Crumbs(LicenseDto l) => [new("Licenses", "admin/licenses"), new(l.Name, null, true)];

    private static string Day(DateTime value) => value.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private IReadOnlyList<DetailItem> DetailItems(LicenseDto l) =>
    [
        new("Client", Content: b =>
        {
            b.OpenComponent<MudLink>(0);
            b.AddAttribute(1, nameof(MudLink.Href), $"admin/clients/{l.ClientId}");
            b.AddAttribute(2, nameof(MudLink.ChildContent), (RenderFragment)(c => c.AddContent(0, l.ClientName)));
            b.CloseComponent();
        }),
        new("License key", l.LicenseKey),
        new("Plan", l.PlanName),
        new("Starts", Day(l.StartsAt)),
        new("Expires", $"{Day(l.ExpiresAt)} ({UiText.Plural(Math.Max(0, l.DaysRemaining), "day")} left)"),
        new("Used", $"{UiText.Number(l.ConsumedCredits)} of {UiText.Number(l.TotalCredits)} credits ({l.UtilisationPercent}%)"),
        new("Suspended", l.SuspendedAt is null ? null : $"{Day(l.SuspendedAt.Value)}: {l.SuspendedReason}"),
        new("Internal notes", l.Notes),
    ];

    private async Task ReloadLedgerAsync()
    {
        if (_ledger is not null)
        {
            await _ledger.ReloadAsync();
        }
    }

    /// <summary>After a dialog whose API call already returned the new license: show it, then refresh the ledger.</summary>
    private async Task<bool> SaveLicenseAsync<T>(T model, RenderFragment<T> fields, string title, string submit, Func<T, Task<ApiResult<LicenseDto>>> call, Func<T, string> success, bool ledgerChanged = false)
        where T : class
    {
        var saved = await Dialogs.SaveAsync(
            Snackbar, title, model, fields,
            async m =>
            {
                var result = await call(m);
                if (result.IsSuccess)
                {
                    _state.Set(result);
                }

                return result.ToFormError();
            },
            submit, success);
        if (saved is not null && ledgerChanged)
        {
            await ReloadLedgerAsync();
        }

        return saved is not null;
    }

    private Task RenameAsync(LicenseDto license) =>
        SaveLicenseAsync(new LicenseNameForm { Name = license.Name, Notes = license.Notes, RowVersion = license.RowVersion }, m => @<LicenseActionFields Rename="m" />,
            "Edit license", "Save changes", m => Api.UpdateAsync(license.Id, m.ToRequest()), _ => "License details saved.");

    private Task RenewAsync(LicenseDto license) =>
        SaveLicenseAsync(new RenewLicenseForm { ExpiresAt = license.ExpiresAt.AddYears(1) }, m => @<LicenseActionFields Renew="m" />,
            "Renew license", "Renew", m => Api.RenewAsync(license.Id, m.ToRequest()), _ => "The license was renewed.", ledgerChanged: true);

    private bool _adjustmentSentForApproval;

    private Task AdjustAsync(LicenseDto license)
    {
        _adjustmentSentForApproval = false;
        return SaveLicenseAsync(new AdjustLicenseForm(), m => @<LicenseActionFields Adjust="m" />,
            "Adjust credits", "Apply adjustment",
            async m =>
            {
                var result = await Api.AdjustAsync(license.Id, m.ToRequest());
                if (!result.IsSuccess)
                {
                    return ApiResult<LicenseDto>.Fail(result.Error!);
                }

                _adjustmentSentForApproval = result.Value.Pending is not null;
                return ApiResult<LicenseDto>.Ok(result.Value.License ?? license); // nothing changed yet when it is waiting for approval
            },
            m => _adjustmentSentForApproval
                ? "This adjustment is above the limit one person can apply. It was sent for approval: another administrator has 24 hours to approve it."
                : m.Credits > 0 ? $"{UiText.Number(m.Credits)} credits were added." : $"{UiText.Number(-m.Credits)} credits were removed.",
            ledgerChanged: true);
    }

    private async Task ApplyStatusAsync(Task<ApiResult<LicenseDto>?> action)
    {
        if (await action is { IsSuccess: true } result)
        {
            _state.Set(result);
            await ReloadLedgerAsync();
        }
    }

    private Task ActivateAsync(LicenseDto license) =>
        ApplyStatusAsync(Dialogs.ConfirmAndApplyAsync(Snackbar, "Activate this license?", "The client can use its credits straight away.", "Activate",
            _ => Api.ActivateAsync(license.Id), "The license is active."));

    private Task SuspendAsync(LicenseDto license) =>
        ApplyStatusAsync(Dialogs.ConfirmAndApplyAsync(Snackbar, "Suspend this license?", "The client cannot use its credits until you activate it again. Nothing is lost.",
            "Suspend license", reason => Api.SuspendAsync(license.Id, reason), "The license was suspended.", destructive: true, requireReason: true));

    private Task RevokeAsync(LicenseDto license) =>
        ApplyStatusAsync(Dialogs.ConfirmAndApplyAsync(Snackbar, "Revoke this license?", "Revoking is permanent: the remaining credits are written off and the license can never be used again.",
            "Revoke license", reason => Api.RevokeAsync(license.Id, reason), "The license was revoked.", destructive: true, requireReason: true, requiredPhrase: "REVOKE"));

    private async Task RefundAsync(LicenseTransactionDto tx)
    {
        var saved = await Dialogs.SaveAsync(
            Snackbar, "Refund this charge", new RefundForm(), m => @<LicenseActionFields Refund="m" />,
            async m => (await Api.RefundAsync(tx.Id, new RefundRequest(m.Reason.Trim()))).ToFormError(),
            "Refund", _ => "The charge was refunded.");
        if (saved is not null)
        {
            // Refresh the license quietly (the page stays on screen) and the ledger once.
            await _state.LoadAsync(ct => Api.GetAsync(Id, ct), keepCurrent: true);
            await ReloadLedgerAsync();
        }
    }

    private async Task VerifyAsync()
    {
        _verifying = true;
        try
        {
            var result = await Api.VerifyLedgerAsync(Id);
            if (result.IsSuccess)
            {
                _verification = result.Value;
            }
            else
            {
                Snackbar.Error(result.Error!);
            }
        }
        finally
        {
            _verifying = false;
        }
    }
}
