@page "/admin/clients/{Id:guid}"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.ClientsRead)]
@inject IClientsApiClient Api
@inject IDialogService Dialogs
@inject IAppSnackbar Snackbar
@inject CurrentUserState User
@implements IDisposable

<PageTitle>@(_state.Result is { IsSuccess: true } r ? r.Value.Name : "Client") · Admin · NexaVerify</PageTitle>

<PageState T="ClientDto" Result="_state.Result" OnRetry="ReloadAsync">
    <Loading><SkeletonCard Lines="4" /></Loading>
    <ChildContent Context="client">
        <PageHeader Title="@client.Name" Subtitle="@($"Client code {client.Code}")" Breadcrumbs="Crumbs(client)">
            <Actions>
                <StatusChip Kind="StatusKind.Client" Value="@client.Status" />
                <Can Permission="@WebPermissions.ClientsUpdate">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit" OnClick="() => EditAsync(client)" data-testid="edit-client">Edit</MudButton>
                </Can>
                <Can Permission="@WebPermissions.ClientsManageStatus">
                    @if (client.Status is "Active")
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.PauseCircle" OnClick="() => SuspendAsync(client)" data-testid="suspend-client">Suspend</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Outlined.Block" OnClick="() => DeactivateAsync(client)" data-testid="deactivate-client">Deactivate</MudButton>
                    }
                    else if (client.Status is not "Deleted")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Outlined.PlayCircle" OnClick="() => ActivateAsync(client)" data-testid="activate-client">
                            @(client.Status is "Suspended" ? "Reactivate" : "Activate")
                        </MudButton>
                    }
                </Can>
            </Actions>
        </PageHeader>

        @if (client.Status is "Suspended" && !string.IsNullOrWhiteSpace(client.StatusReason))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4" data-testid="suspend-reason">Suspended: @client.StatusReason</MudAlert>
        }

        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" TabPanelsClass="pt-4" Class="nv-tabs" aria-label="Client sections">
            <MudTabPanel Text="Overview"><ClientOverviewTab Client="client" /></MudTabPanel>
            <MudTabPanel Text="Users"><ClientUsersTab ClientId="client.Id" /></MudTabPanel>
            @if (User.Has(WebPermissions.ClientsSettings))
            {
                <MudTabPanel Text="Settings"><ClientSettingsTab ClientId="client.Id" /></MudTabPanel>
            }
            @if (User.Has(WebPermissions.LicensesRead))
            {
                <MudTabPanel Text="License"><ClientLicensesTab ClientId="client.Id" /></MudTabPanel>
            }
            @if (User.Has(WebPermissions.AuditRead))
            {
                <MudTabPanel Text="Audit"><ClientAuditPanel ClientId="client.Id" /></MudTabPanel>
            }
        </MudTabs>
    </ChildContent>
</PageState>

@code {
    private readonly LoadState<ClientDto> _state = new();
    private Guid? _loadedId;

    [Parameter] public Guid Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
        {
            return; // same client: nothing to reload when the parent merely re-renders
        }

        _loadedId = Id;
        await _state.LoadAsync(ct => Api.GetAsync(Id, ct));
    }

    private Task ReloadAsync() => _state.LoadAsync(ct => Api.GetAsync(Id, ct));

    public void Dispose() => _state.Dispose();

    private static List<BreadcrumbItem> Crumbs(ClientDto client) => [new("Clients", "admin/clients"), new(client.Name, null, true)];

    private async Task EditAsync(ClientDto client)
    {
        var saved = await Dialogs.SaveAsync(
            Snackbar, "Edit client", ClientForm.From(client), m => @<ClientFields Model="m" />,
            async m => (await Api.UpdateAsync(client.Id, m.ToUpdateRequest())).ToFormError(),
            "Save changes", _ => "Client details saved.");
        if (saved is not null)
        {
            await _state.LoadAsync(ct => Api.GetAsync(Id, ct), keepCurrent: true);
        }
    }

    private Task SuspendAsync(ClientDto client) =>
        ApplyAsync(Dialogs.ConfirmAndApplyAsync(
            Snackbar, $"Suspend {client.Name}?", "Their users are signed out and API access stops straight away. You can reactivate them at any time.",
            "Suspend client", reason => Api.SuspendAsync(client.Id, reason), $"{client.Name} was suspended.", destructive: true, requireReason: true));

    private Task DeactivateAsync(ClientDto client) =>
        ApplyAsync(Dialogs.ConfirmAndApplyAsync(
            Snackbar, $"Deactivate {client.Name}?", "Their users are signed out and API access stops. Use this when the company is no longer a customer.",
            "Deactivate client", reason => Api.DeactivateAsync(client.Id, reason), $"{client.Name} was deactivated.", destructive: true, requireReason: true));

    private Task ActivateAsync(ClientDto client)
    {
        var verb = client.Status is "Suspended" ? "Reactivate" : "Activate";
        return ApplyAsync(Dialogs.ConfirmAndApplyAsync(
            Snackbar, $"{verb} {client.Name}?", "Their users can sign in again and API access resumes.", verb,
            _ => Api.ActivateAsync(client.Id), $"{client.Name} is active again."));
    }

    private async Task ApplyAsync(Task<ApiResult<ClientDto>?> action)
    {
        if (await action is { IsSuccess: true } result)
        {
            _state.Set(result);
        }
    }
}
