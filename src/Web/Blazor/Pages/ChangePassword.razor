@page "/change-password"
@layout AuthLayout
@using NexaVerify.Web.Security
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = Policies.SignedIn)]
@inject IPortalAuth PortalAuth
@inject ICurrentSession Session
@inject NavigationManager Nav
@inject IAppSnackbar Snackbar

<PageTitle>Change your password · NexaVerify</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1">@(_forced ? "Choose a new password" : "Change your password")</MudText>
<MudText Typo="Typo.body1" Class="nv-muted mb-5">
    @(_forced
        ? "For your security you need to choose your own password before you continue."
        : "Choose a new password. You will stay signed in on this device; other devices are signed out.")
</MudText>

<EditForm Model="_model" OnValidSubmit="SubmitAsync" novalidate>
    <DataAnnotationsValidator />
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert" data-testid="change-error">
            @_error.Message
            @if (!string.IsNullOrWhiteSpace(_error.CorrelationId))
            {
                <MudText Typo="Typo.caption" Class="d-block">Reference: @_error.CorrelationId</MudText>
            }
        </MudAlert>
    }
    <MudTextField T="string" @bind-Value="_model.CurrentPassword" For="() => _model.CurrentPassword" Label="Current password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Immediate="true" Class="mb-3" AutoFocus="true" Disabled="_busy" autocomplete="current-password" />
    <MudTextField T="string" @bind-Value="_model.NewPassword" For="() => _model.NewPassword" Label="New password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Immediate="true" Class="mb-3" Disabled="_busy" autocomplete="new-password" HelperText="At least 12 characters" />
    <MudTextField T="string" @bind-Value="_model.ConfirmPassword" For="() => _model.ConfirmPassword" Label="Confirm new password" InputType="InputType.Password"
                  Variant="Variant.Outlined" Immediate="true" Class="mb-4" Disabled="_busy" autocomplete="new-password" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_busy" data-testid="change-submit">
        @(_busy ? "Saving…" : "Change password")
    </MudButton>
</EditForm>

@code {
    private readonly ChangePasswordModel _model = new();
    private ApiError? _error;
    private bool _busy;
    private bool _forced;

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            _forced = user.HasClaim(PortalClaims.MustChangePassword, "true");
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var sessionId = await Session.GetSessionIdAsync();
            if (sessionId is null)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }

            var result = await PortalAuth.ChangePasswordAsync(sessionId, _model);
            if (!result.IsSuccess)
            {
                _error = result.Error;
                _model.CurrentPassword = string.Empty;
                return;
            }

            Snackbar.Success("Your password has been changed.");
            // A full page load picks up the refreshed session (the forced-change flag is gone) and the right portal home.
            var portal = (await AuthState!).User.FindFirst(PortalClaims.Portal)?.Value ?? PortalKinds.Client;
            Nav.NavigateTo(ReturnUrl.HomeFor(portal), forceLoad: true);
        }
        finally
        {
            _busy = false;
        }
    }
}
