@page "/forgot-password"
@layout AuthLayout
@inject IAuthApiClient Auth

<PageTitle>Reset your password · NexaVerify</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1">Forgot your password?</MudText>
@if (_sent)
{
    <MudAlert Severity="Severity.Success" Class="mt-4" role="status" data-testid="forgot-sent">
        If there is an account for that email address, we have sent a link to reset the password. The link works for 30 minutes.
    </MudAlert>
    <MudButton Href="login" Variant="Variant.Text" Class="mt-4" StartIcon="@Icons.Material.Outlined.ArrowBack">Back to sign in</MudButton>
}
else
{
    <MudText Typo="Typo.body1" Class="nv-muted mb-5">Enter your email address and we will send you a link to choose a new password.</MudText>
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" novalidate>
        <DataAnnotationsValidator />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">
                @_error.Message
                @if (!string.IsNullOrWhiteSpace(_error.CorrelationId))
                {
                    <MudText Typo="Typo.caption" Class="d-block">Reference: @_error.CorrelationId</MudText>
                }
            </MudAlert>
        }
        <MudTextField T="string" @bind-Value="_model.Email" For="() => _model.Email" Label="Email address" InputType="InputType.Email"
                      Variant="Variant.Outlined" Immediate="true" Class="mb-4" AutoFocus="true" Disabled="_busy" autocomplete="username" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_busy">
            @(_busy ? "Sending…" : "Send reset link")
        </MudButton>
        <div class="d-flex justify-center mt-3">
            <MudLink Href="login" Typo="Typo.body2">Back to sign in</MudLink>
        </div>
    </EditForm>
}

@code {
    private readonly ForgotPasswordModel _model = new();
    private ApiError? _error;
    private bool _busy;
    private bool _sent;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.ForgotPasswordAsync(_model);
            if (result.IsSuccess)
            {
                _sent = true;
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
