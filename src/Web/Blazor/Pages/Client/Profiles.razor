@page "/client/profiles"
@implements IDisposable
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.FacesRead)]
@inject IFacesApiClient Api
@inject IDialogService Dialogs
@inject IAppSnackbar Snackbar

<PageTitle>People · NexaVerify</PageTitle>

<PageHeader Title="People" Subtitle="Everyone you have registered for face recognition.">
    <Actions>
        <Can Permission="@WebPermissions.FacesEnroll">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd" Href="client/enroll" data-testid="register-person">Register a person</MudButton>
        </Can>
    </Actions>
</PageHeader>

<MudPaper Class="nv-card" Elevation="0">
    <div class="pa-4">
        <FilterBar SearchLabel="Search people" SearchPlaceholder="Reference or name" OnSearch="OnSearch" ExtraFiltersActive="@(_status is not null)" OnReset="ResetFilters">
            <Filters>
                <MudSelect T="string" Value="_status" ValueChanged="OnStatus" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Style="min-width: 160px;">
                    <MudSelectItem T="string" Value="@("Active")">Active</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Disabled")">Disabled</MudSelectItem>
                </MudSelect>
            </Filters>
        </FilterBar>
    </div>
    <DataTable @ref="_table" @key="@($"{_status}")" T="FaceProfileListItemDto" Caption="People" Columns="_columns" Search="@_search"
               LoadPage="(p, ct) => Api.ListProfilesAsync(new FaceProfileListQuery { Page = p.Page, PageSize = p.PageSize, Search = p.Search, Status = _status }, ct)"
               EmptyMessage="Nobody is registered yet. Register your first person to start recognising faces.">
        <RowActions Context="person">
            <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"client/profiles/{person.Id}")" aria-label="@($"Open {person.ExternalRef}")">Open</MudButton>
            <Can Permission="@WebPermissions.FacesErase">
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => EraseAsync(person)" aria-label="@($"Erase {person.ExternalRef}")" data-testid="erase-person">Erase</MudButton>
            </Can>
        </RowActions>
    </DataTable>
</MudPaper>

@code {
    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private DataTable<FaceProfileListItemDto>? _table;
    private IReadOnlyList<DataColumn<FaceProfileListItemDto>> _columns = [];
    private string? _search;
    private string? _status;

    protected override void OnInitialized() =>
        _columns =
        [
            DataColumn<FaceProfileListItemDto>.Text("Reference", p => p.ExternalRef),
            DataColumn<FaceProfileListItemDto>.Text("Name", p => p.DisplayName),
            DataColumn<FaceProfileListItemDto>.Custom("Status", p => @<StatusChip Kind="StatusKind.User" Value="@p.Status" />),
            DataColumn<FaceProfileListItemDto>.Text("Photos", p => UiText.Number(p.TemplateCount), numeric: true),
            DataColumn<FaceProfileListItemDto>.Text("Kept until", p => p.RetentionUntil?.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)),
            DataColumn<FaceProfileListItemDto>.Text("Registered", p => p.CreatedAt.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)),
        ];

    private void OnSearch(string? text) => _search = text;

    private void OnStatus(string? status) => _status = status;

    private void ResetFilters() => _status = null;

    private async Task EraseAsync(FaceProfileListItemDto person)
    {
        var confirmed = await Dialogs.ConfirmAsync(
            $"Erase {person.ExternalRef}?",
            "This permanently deletes this person and all their face data. It cannot be undone. Past results in your history stay, but no longer point to a person.",
            "Erase person", destructive: true, requiredPhrase: "ERASE");
        if (confirmed is null)
        {
            return;
        }

        var result = await Api.EraseProfileAsync(person.Id, _cts.Token);
        if (result.Report(Snackbar, "The person was erased.") && _table is not null)
        {
            await _table.ReloadAsync();
        }
    }
}
