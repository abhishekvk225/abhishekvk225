@page "/client/users"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.UsersManage)]
@inject IClientAccountApiClient Api
@inject IDialogService Dialogs
@inject IAppSnackbar Snackbar

<PageTitle>People with access · NexaVerify</PageTitle>

<PageHeader Title="People with access" Subtitle="Who in your company can sign in to this portal.">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PersonAdd" OnClick="InviteAsync" data-testid="invite-user">Invite someone</MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="nv-card" Elevation="0">
    <DataTable @ref="_table" T="ClientUserDto" Caption="People with access" Columns="_columns" LoadPage="(p, ct) => Api.ListUsersAsync(p, ct)" PageSize="25"
               EmptyMessage="Nobody else has access yet. Invite a colleague to get started.">
        <RowActions Context="user">
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => EditAsync(user)" aria-label="@($"Edit {user.FullName}")" data-testid="edit-user">Edit</MudButton>
            @if (!user.IsOwner)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ToggleAsync(user)" aria-label="@($"{(IsActive(user) ? "Turn off access for" : "Restore access for")} {user.FullName}")" data-testid="toggle-user">@(IsActive(user) ? "Turn off access" : "Restore access")</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ResetAsync(user)" aria-label="@($"Send a password reset to {user.FullName}")" data-testid="reset-user">Reset password</MudButton>
        </RowActions>
    </DataTable>
</MudPaper>

@code {
    private DataTable<ClientUserDto>? _table;
    private IReadOnlyList<DataColumn<ClientUserDto>> _columns = [];

    protected override void OnInitialized() =>
        _columns =
        [
            DataColumn<ClientUserDto>.Text("Name", u => u.IsOwner ? $"{u.FullName} (owner)" : u.FullName),
            DataColumn<ClientUserDto>.Text("Email", u => u.Email),
            DataColumn<ClientUserDto>.Text("Role", u => RoleLabel(u.Role)),
            DataColumn<ClientUserDto>.Custom("Status", u => @<StatusChip Kind="StatusKind.User" Value="@u.Status" />),
            DataColumn<ClientUserDto>.Text("Last signed in", u => u.LastLoginAt?.ToString("d MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "Never"),
        ];

    private static bool IsActive(ClientUserDto user) => string.Equals(user.Status, "Active", StringComparison.OrdinalIgnoreCase);

    private static string RoleLabel(string role) => role switch
    {
        "ClientAdmin" => "Administrator",
        "ClientUser" => "Team member",
        _ => role,
    };

    private async Task InviteAsync()
    {
        var saved = await Dialogs.ShowFormAsync(
            "Invite someone", new InviteUserForm(), m => @<ClientUserFields Model="m" />,
            async m => (await Api.CreateUserAsync(m.ToCreate())).ToFormError(),
            "Send invitation");
        if (saved is not null)
        {
            Snackbar.Success($"We emailed an invitation to {saved.Email}.");
            await ReloadAsync();
        }
    }

    private async Task EditAsync(ClientUserDto user)
    {
        var saved = await Dialogs.ShowFormAsync(
            "Edit person", InviteUserForm.From(user), m => @<ClientUserFields Model="m" />,
            async m => (await Api.UpdateUserAsync(user.Id, m.ToUpdate())).ToFormError(),
            "Save changes");
        if (saved is not null)
        {
            Snackbar.Success("The changes were saved.");
            await ReloadAsync();
        }
    }

    private async Task ToggleAsync(ClientUserDto user)
    {
        var turnOff = IsActive(user);
        var confirmed = await Dialogs.ConfirmAsync(
            turnOff ? $"Turn off access for {user.FullName}?" : $"Restore access for {user.FullName}?",
            turnOff ? "They are signed out and can no longer sign in. You can restore access at any time." : "They will be able to sign in again.",
            turnOff ? "Turn off access" : "Restore access", destructive: turnOff);
        if (confirmed is null)
        {
            return;
        }

        var form = InviteUserForm.From(user);
        form.IsActive = !turnOff;
        if ((await Api.UpdateUserAsync(user.Id, form.ToUpdate())).Report(Snackbar, turnOff ? "Access was turned off." : "Access was restored."))
        {
            await ReloadAsync();
        }
    }

    private async Task ResetAsync(ClientUserDto user)
    {
        var confirmed = await Dialogs.ConfirmAsync(
            $"Reset the password for {user.FullName}?", "We email them a link to choose a new password. Their current password stops working.", "Send reset email");
        if (confirmed is not null)
        {
            (await Api.ResetUserPasswordAsync(user.Id)).Report(Snackbar, "We sent a password reset email.");
        }
    }

    private Task ReloadAsync() => _table is null ? Task.CompletedTask : _table.ReloadAsync();
}
