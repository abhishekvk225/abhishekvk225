@page "/client/verification/bank-statement"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.VerificationBankStatementSubmit)]
@inject IVerificationApiClient Api

<PageTitle>Bank statement check · NexaVerify</PageTitle>

<VerificationSubmitPanel ModuleKey="@VerificationModuleKeys.BankStatement" Title="Bank statement check"
                         Subtitle="Upload a statement and we read the account details and transactions, then look for gaps and numbers that do not add up."
                         DocumentLabel="Bank statement" SubmitText="Check statement" Model="_form"
                         RequestFingerprint="() => _form.ToRequest()" Submit="SubmitAsync" ExtraCheck="Check" OnAccepted="Reset">
    <Fields>
        <MudTextField T="string" @bind-Value="_form.AccountHolderName" For="() => _form.AccountHolderName" Label="Account holder name (optional)" Variant="Variant.Outlined" Immediate="true"
                      HelperText="If you enter it, we compare it with the statement." MaxLength="150" />
        <MudTextField T="string" @bind-Value="_form.BankName" For="() => _form.BankName" Label="Bank name (optional)" Variant="Variant.Outlined" Immediate="true" MaxLength="100" />
        <MudTextField T="string" @bind-Value="_form.AccountNumberLast4" For="() => _form.AccountNumberLast4" Label="Last 4 digits of the account (optional)" Variant="Variant.Outlined" Immediate="true" MaxLength="4" />
        <MudDatePicker @bind-Date="_form.PeriodFrom" Label="Statement starts (optional)" Variant="Variant.Outlined" Editable="true" />
        <MudDatePicker @bind-Date="_form.PeriodTo" Label="Statement ends (optional)" Variant="Variant.Outlined" Editable="true" />
    </Fields>
</VerificationSubmitPanel>

@code {
    private BankStatementForm _form = new();

    private static string? Check(DocumentUploadFile? file) => file is null ? "Add the bank statement first." : null;

    private Task<ApiResult<VerificationAcceptedDto>> SubmitAsync(DocumentUploadFile? file, string key, IProgress<long> progress, CancellationToken ct) =>
        Api.SubmitBankStatementAsync(_form.ToRequest(), file!, key, progress, ct);

    private void Reset() => _form = new();
}
