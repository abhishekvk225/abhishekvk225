@page "/client/verification/pan"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.VerificationPanSubmit)]
@inject IVerificationApiClient Api

<PageTitle>PAN check · NexaVerify</PageTitle>

<VerificationSubmitPanel ModuleKey="@VerificationModuleKeys.Pan" Title="PAN check"
                         Subtitle="Upload a PAN card, or just type the number. We check the format and compare what we read with the details you enter."
                         DocumentLabel="PAN card (optional if you enter the number)" SubmitText="Check PAN" Model="_form"
                         RequestFingerprint="() => _form.ToRequest()" Submit="SubmitAsync" ExtraCheck="Check" OnAccepted="Reset">
    <Fields>
        <MudTextField T="string" @bind-Value="_form.PanNumber" For="() => _form.PanNumber" Label="PAN number" Variant="Variant.Outlined" Immediate="true" MaxLength="12"
                      HelperText="Needed if you do not upload a card. Example: ABCDE1234F." data-testid="pan-number" />
        <MudTextField T="string" @bind-Value="_form.FullName" For="() => _form.FullName" Label="Name of the holder" Variant="Variant.Outlined" Immediate="true" Required="true" MaxLength="150" data-testid="pan-name" />
        <MudDatePicker @bind-Date="_form.DateOfBirth" Label="Date of birth (optional)" Variant="Variant.Outlined" Editable="true" />
        <MudTextField T="string" @bind-Value="_form.FatherName" For="() => _form.FatherName" Label="Father's name (optional)" Variant="Variant.Outlined" Immediate="true" MaxLength="150" />
    </Fields>
</VerificationSubmitPanel>

@code {
    private PanForm _form = new();

    private string? Check(DocumentUploadFile? file) =>
        file is null && string.IsNullOrWhiteSpace(_form.PanNumber) ? "Add the PAN card or enter the PAN number." : null;

    private Task<ApiResult<VerificationAcceptedDto>> SubmitAsync(DocumentUploadFile? file, string key, IProgress<long> progress, CancellationToken ct) =>
        Api.SubmitPanAsync(_form.ToRequest(), file, key, progress, ct);

    private void Reset() => _form = new();
}
