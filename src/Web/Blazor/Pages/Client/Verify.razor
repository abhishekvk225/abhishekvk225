@page "/client/verify"
@attribute [Authorize(Policy = Policies.PermissionPrefix + WebPermissions.FacesVerify)]
@implements IDisposable
@inject IFacesApiClient Api
@inject IAppSnackbar Snackbar

<PageTitle>Check a person · NexaVerify</PageTitle>

<PageHeader Title="Check a person" Subtitle="Is this the person they say they are? Upload a photo and say who it should be." />

<MudGrid Spacing="3">
    <MudItem xs="12" lg="7">
        <MudPaper Class="nv-card nv-card-pad" Elevation="0">
            <EditForm Model="_form" OnValidSubmit="SubmitAsync" novalidate>
                <DataAnnotationsValidator />
                <div class="nv-form">
                    <MudTextField T="string" @bind-Value="_form.ExternalRef" For="() => _form.ExternalRef" Label="Reference of the person to check" Variant="Variant.Outlined" Immediate="true"
                                  HelperText="The reference you used when you registered them." MaxLength="100" Disabled="_busy" data-testid="verify-ref" />
                    <div>
                        <MudText Typo="Typo.subtitle2" HtmlTag="h2" Class="mb-2">Photo</MudText>
                        <FacePhotoInput Image="_image" ImageChanged="OnImageChanged" />
                        @if (_photoProblem is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" role="alert" data-testid="photo-problem">@_photoProblem</MudAlert>
                        }
                    </div>
                    @if (_error is not null)
                    {
                        <ErrorState Error="_error" />
                        @if (_photoKept)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" data-testid="photo-kept">
                                Your photo is still here. Press the button again to retry; if the first attempt did go through, you will not be charged twice.
                            </MudAlert>
                        }
                    }
                    <div>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _image is null)" data-testid="verify-submit">
                            @(_busy ? "Checking…" : "Check")
                        </MudButton>
                    </div>
                </div>
            </EditForm>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <div aria-live="polite" data-testid="verify-result">
            @if (_result is not null)
            {
                <MudPaper Class="nv-card nv-card-pad" Elevation="0">
                    <div class="d-flex align-center mb-3" style="gap: var(--nv-space-3);">
                        <StatusChip Kind="StatusKind.Outcome" Value="@_result.Outcome" />
                        <MudText Typo="Typo.h5" HtmlTag="p" data-testid="verify-verdict">@(_result.Match ? "This looks like the same person." : "This does not look like the same person.")</MudText>
                    </div>
                    <DetailList Items="Items()" />
                    <div class="mt-3"><ChargeSummary Credits="_result.Credits" ElapsedMs="_elapsedMs" /></div>
                </MudPaper>
            }
        </div>
    </MudItem>
</MudGrid>

@code {
    private readonly VerifyForm _form = new();
    private CapturedImage? _image;
    private bool _busy;
    private string? _photoProblem;
    private ApiError? _error;
    private VerifyFaceResponse? _result;
    private long _elapsedMs;
    private bool _photoKept;
    private readonly PhotoAttempt _attempt = new();
    private readonly CancellationTokenSource _cts = new();

    // Success: the photo is no longer needed, so overwrite it and start a new logical request next time.
    private void Settle(CapturedImage image)
    {
        PhotoGuard.Forget(image);
        _image = null;
        _photoKept = false;
        _attempt.Reset();
    }

    // Failure: the photo stays until the user removes it or it succeeds. A temporary failure keeps the idempotency key too, so the
    // retry cannot be charged a second time; a definitive refusal starts over with a new key (the photo or details will change).
    private void KeepOrSettleFailure(ApiError error)
    {
        _photoKept = true;
        if (!PhotoGuard.IsRetryable(error))
        {
            _attempt.Reset();
        }
    }

    private void OnImageChanged(CapturedImage? image)
    {
        _image = image;
        _photoKept = false;
        _attempt.Reset(); // a different photo is a different request
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        PhotoGuard.Forget(_image);
    }

    private async Task SubmitAsync()
    {
        _photoProblem = PhotoGuard.Check(_image);
        if (_photoProblem is not null)
        {
            return;
        }

        var image = _image!;
        _busy = true;
        _error = null;
        _result = null;
        try
        {
            var started = System.Diagnostics.Stopwatch.GetTimestamp();
            var request = _form.ToRequest();
            ApiResult<VerifyFaceResponse> result;
            try
            {
                result = await Api.VerifyAsync(request, image, _attempt.KeyFor(request), _cts.Token);
            }
            catch (OperationCanceledException)
            {
                return; // the page was left: stop quietly
            }

            _elapsedMs = (long)System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds;
            if (result.IsSuccess)
            {
                Settle(image);
                _result = result.Value;
            }
            else
            {
                _error = result.Error;
                Snackbar.Error(result.Error!);
                KeepOrSettleFailure(result.Error!);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private IReadOnlyList<DetailItem> Items() =>
    [
        new("Similarity score", _result!.Score.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)),
        new("Needed to count as a match", _result.Threshold.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)),
    ];
}
