@page "/login"
@layout AuthLayout
@using NexaVerify.Web.Security
@inject IHostEnvironment Env
@inject NavigationManager Nav

<PageTitle>Sign in · NexaVerify</PageTitle>

@* Static server-rendered page: a plain HTML form that posts to /auth/login (antiforgery-protected). Only a normal HTTP response can
   set the session cookie, and the browser never receives a token. *@
<h1 class="mud-typography mud-typography-h2">Welcome back</h1>
<p class="mud-typography mud-typography-body1 nv-muted nv-form-lead">Sign in to manage your face recognition account.</p>

@if (!string.IsNullOrEmpty(Message))
{
    <div class="nv-alert nv-alert-error" role="alert" data-testid="login-error">
        <span>@Message</span>
        @if (Reference is not null)
        {
            <span class="nv-alert-ref">Reference: @Reference</span>
        }
    </div>
}
else if (SignedOut == "1")
{
    <div class="nv-alert nv-alert-info" role="status" data-testid="login-signed-out">You have been signed out.</div>
}

<form method="post" action="/auth/login" class="nv-form" novalidate data-testid="login-form">
    <AntiforgeryToken />
    @if (ReturnUrlValue is not null)
    {
        <input type="hidden" name="returnUrl" value="@ReturnUrlValue" />
    }

    <div class="nv-field">
        <label for="login-email" class="nv-label">Email address</label>
        <input id="login-email" name="email" type="email" class="nv-input" autocomplete="username" required maxlength="256" autofocus />
    </div>

    <div class="nv-field">
        <label for="login-password" class="nv-label">Password</label>
        <input id="login-password" name="password" type="password" class="nv-input" autocomplete="current-password" required maxlength="256" />
    </div>

    <div class="nv-form-row">
        <a href="forgot-password" class="nv-link">Forgot your password?</a>
    </div>

    <button type="submit" class="nv-btn nv-btn-primary" data-testid="login-submit">Sign in</button>
</form>

@if (Env.IsDevelopment())
{
    <p class="nv-muted nv-dev-hint" data-testid="dev-hint">Development build: sign in with a user of the API configured in Api:BaseUrl.</p>
}

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "ref")] public string? Ref { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrlQuery { get; set; }

    [SupplyParameterFromQuery(Name = "signedOut")] public string? SignedOut { get; set; }

    private string? Message => string.IsNullOrEmpty(Error) ? null : NullIfEmpty(LoginErrors.MessageFor(Error));

    private string? Reference => AuthEndpoints.SanitiseReference(Ref);

    private string? ReturnUrlValue => ReturnUrl.IsSafe(ReturnUrlQuery) ? ReturnUrlQuery : null;

    [CascadingParameter] private HttpContext? Http { get; set; }

    protected override void OnInitialized()
    {
        // Already signed in (and not stuck on a forced password change): go where they were heading instead of asking again.
        if (Http?.User is { Identity.IsAuthenticated: true } user
            && user.FindFirst(PortalClaims.Portal)?.Value is { } portal
            && !user.HasClaim(PortalClaims.MustChangePassword, "true"))
        {
            Nav.NavigateTo(ReturnUrl.ResolveForPortal(ReturnUrlQuery, portal));
        }
    }

    private static string? NullIfEmpty(string value) => value.Length == 0 ? null : value;
}
