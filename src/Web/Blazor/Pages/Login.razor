@page "/login"
@layout AuthLayout
@inject IAuthApiClient Auth
@inject CurrentUserState User
@inject NavigationManager Nav
@inject IHostEnvironment Env

<PageTitle>Sign in · NexaVerify</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1">Welcome back</MudText>
<MudText Typo="Typo.body1" Class="nv-muted mb-5">Sign in to manage your face recognition account.</MudText>

<EditForm Model="_model" OnValidSubmit="SubmitAsync" novalidate>
    <DataAnnotationsValidator />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert" data-testid="login-error">
            @_error.Message
            @if (!string.IsNullOrWhiteSpace(_error.CorrelationId))
            {
                <MudText Typo="Typo.caption" Class="d-block">Reference: @_error.CorrelationId</MudText>
            }
        </MudAlert>
    }

    <MudTextField T="string" @bind-Value="_model.Email" For="() => _model.Email" Label="Email address" InputType="InputType.Email"
                  Variant="Variant.Outlined" Immediate="true" Class="mb-3" AutoFocus="true" Disabled="_busy" autocomplete="username" />

    <MudTextField T="string" @bind-Value="_model.Password" For="() => _model.Password" Label="Password" InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                  Variant="Variant.Outlined" Immediate="true" Disabled="_busy" autocomplete="current-password"
                  Adornment="Adornment.End" AdornmentIcon="@(_showPassword ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                  OnAdornmentClick="() => _showPassword = !_showPassword" AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")" />

    <div class="d-flex justify-end mt-1 mb-4">
        <MudLink Href="forgot-password" Typo="Typo.body2">Forgot your password?</MudLink>
    </div>

    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_busy" data-testid="login-submit">
        @if (_busy)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            <span>Signing in…</span>
        }
        else
        {
            <span>Sign in</span>
        }
    </MudButton>
</EditForm>

@if (Env.IsDevelopment())
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-5" data-testid="demo-hint">
        Preview build: any password works. Use an email containing "admin" for the admin console, "fail&#64;…" to see the error state, anything else for the client portal.
    </MudAlert>
}

@code {
    private readonly LoginModel _model = new();
    private ApiError? _error;
    private bool _busy;
    private bool _showPassword;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.LoginAsync(_model);
            if (!result.IsSuccess)
            {
                _error = result.Error;
                _model.Password = string.Empty;
                return;
            }

            var user = result.Value;
            User.SignIn(user.DisplayName, user.Email, user.RoleName, user.ClientName, user.Permissions);
            Nav.NavigateTo(user.Portal == Portal.Admin ? "admin" : "client");
        }
        finally
        {
            _busy = false;
        }
    }
}
