@page "/reset-password"
@layout AuthLayout
@inject IAuthApiClient Auth

<PageTitle>Choose a new password · NexaVerify</PageTitle>

<MudText Typo="Typo.h2" HtmlTag="h1">Choose a new password</MudText>
@if (_done)
{
    <MudAlert Severity="Severity.Success" Class="mt-4" role="status" data-testid="reset-done">Your password has been changed. You can sign in with it now.</MudAlert>
    <MudButton Href="login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4">Go to sign in</MudButton>
}
else
{
    <MudText Typo="Typo.body1" Class="nv-muted mb-5">Use at least @PasswordRules.MinLength characters. A few unrelated words make a strong, easy-to-remember password.</MudText>
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" novalidate>
        <DataAnnotationsValidator />
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert" data-testid="reset-error">
                @_error.Message
                @if (!string.IsNullOrWhiteSpace(_error.CorrelationId))
                {
                    <MudText Typo="Typo.caption" Class="d-block">Reference: @_error.CorrelationId</MudText>
                }
            </MudAlert>
        }
        <MudTextField T="string" @bind-Value="_model.NewPassword" For="() => _model.NewPassword" Label="New password" InputType="InputType.Password"
                      Variant="Variant.Outlined" Immediate="true" Class="mb-3" AutoFocus="true" Disabled="_busy" autocomplete="new-password" HelperText="At least 12 characters" />
        <MudTextField T="string" @bind-Value="_model.ConfirmPassword" For="() => _model.ConfirmPassword" Label="Confirm new password" InputType="InputType.Password"
                      Variant="Variant.Outlined" Immediate="true" Class="mb-4" Disabled="_busy" autocomplete="new-password" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Disabled="_busy">
            @(_busy ? "Saving…" : "Change password")
        </MudButton>
    </EditForm>
}

@code {
    private readonly ResetPasswordModel _model = new();
    private ApiError? _error;
    private bool _busy;
    private bool _done;

    /// <summary>One-time token from the emailed link. Kept out of the page content.</summary>
    [SupplyParameterFromQuery(Name = "token")] public string? Token { get; set; }

    protected override void OnParametersSet() => _model.Token = Token ?? string.Empty;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.ResetPasswordAsync(_model);
            if (result.IsSuccess)
            {
                _done = true;
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
