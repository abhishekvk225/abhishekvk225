@page "/not-found"
@layout MarketingLayout

<SeoHead Title="Page not found" Path="/not-found" NoIndex="true" Description="We could not find the page you were looking for." />

<PageHero Eyebrow="Error 404" Title="We couldn't find that page" Lead="The link may be out of date, or the page may have moved.">
    <div class="mk-hero-actions" data-testid="not-found-actions">
        <a href="/" class="mk-btn mk-btn-primary mk-btn-lg">Go to the home page</a>
        <a href="/login" class="mk-btn mk-btn-outline mk-btn-lg">Sign in</a>
        <a href="/contact" class="mk-link">Contact us</a>
    </div>
</PageHero>
