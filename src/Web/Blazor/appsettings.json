{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "",
    "TimeoutSeconds": 30
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutHours": 12,
    "RefreshSkewSeconds": 30
  },
  "Security": {
    "Headers": {
      "Enabled": true,
      "ContentSecurityPolicyEnabled": true,
      "AllowInsecureWebSockets": false,
      "ApiOrigin": "",
      "ExtraScriptSrc": "",
      "CameraAllowedForSelf": true
    },
    "Cookies": {
      "RequireSecure": true,
      "SameSite": "Strict"
    }
  }
}
