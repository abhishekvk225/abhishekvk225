<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" HtmlTag="h2">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" data-testid="confirm-message">@Message</MudText>

        @if (RequireReason)
        {
            <MudTextField T="string" @bind-Value="_reason" Immediate="true" Label="@ReasonLabel" Lines="3" Variant="Variant.Outlined" Class="mt-4" data-testid="confirm-reason" />
        }

        @if (!string.IsNullOrEmpty(RequiredPhrase))
        {
            <MudText Typo="Typo.body2" Class="mt-4">
                To confirm, type <strong data-testid="confirm-phrase">@RequiredPhrase</strong> below.
            </MudText>
            <MudTextField T="string" @bind-Value="_typed" Immediate="true" Label="Type to confirm" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2"
                          AutoFocus="true" data-testid="confirm-input" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" data-testid="confirm-cancel">@CancelText</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(Destructive ? Color.Error : Color.Primary)" Disabled="!CanConfirm" OnClick="Submit" data-testid="confirm-ok">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _typed;
    private string? _reason;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Are you sure?";

    /// <summary>Plain text that states the consequence (rendered as text, never as markup).</summary>
    [Parameter] public string Message { get; set; } = string.Empty;

    [Parameter] public string ConfirmText { get; set; } = "Confirm";

    [Parameter] public string CancelText { get; set; } = "Cancel";

    [Parameter] public bool Destructive { get; set; }

    /// <summary>When set the user must type exactly this phrase before the confirm button enables (type-to-confirm variant).</summary>
    [Parameter] public string? RequiredPhrase { get; set; }

    [Parameter] public bool RequireReason { get; set; }

    [Parameter] public string ReasonLabel { get; set; } = "Reason (recorded in the audit log)";

    private bool CanConfirm =>
        (string.IsNullOrEmpty(RequiredPhrase) || string.Equals(_typed?.Trim(), RequiredPhrase, StringComparison.Ordinal))
        && (!RequireReason || !string.IsNullOrWhiteSpace(_reason));

    private void Submit()
    {
        if (CanConfirm)
        {
            MudDialog.Close(DialogResult.Ok(new ConfirmResult(string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim())));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
