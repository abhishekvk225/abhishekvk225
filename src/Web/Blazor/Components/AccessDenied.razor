@using Microsoft.AspNetCore.Components.Authorization
@using NexaVerify.Web.Security

<div data-testid="access-denied" role="alert">
    <EmptyState Icon="@Icons.Material.Outlined.Lock" Title="You don't have access to this page"
                Message="Your account isn't allowed to open this page. If you think it should be, ask your administrator.">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@HomeHref">Go to my dashboard</MudButton>
    </EmptyState>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string HomeHref { get; set; } = "/login";

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is not null)
        {
            var portal = (await AuthState).User.FindFirst(PortalClaims.Portal)?.Value;
            HomeHref = portal is null ? "/login" : ReturnUrl.HomeFor(portal);
        }
    }
}
