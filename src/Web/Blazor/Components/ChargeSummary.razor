@using NexaVerify.Contracts.Faces

<ul class="nv-bars" style="gap: var(--nv-space-1);" data-testid="charge-summary" aria-label="Cost and speed">
    <li style="display:block">Credits used: <strong data-testid="credits-charged">@UiText.Number(Credits.Charged)</strong></li>
    @if (Credits.Remaining is { } remaining)
    {
        <li style="display:block">Credits left: <strong data-testid="credits-remaining">@UiText.Number(remaining)</strong></li>
    }
    @if (ElapsedMs is { } ms)
    {
        <li style="display:block">Took: <strong data-testid="elapsed">@UiText.Number(ms) ms</strong></li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public CreditsDto Credits { get; set; } = new(0, null);

    /// <summary>Round trip measured by the portal for this request.</summary>
    [Parameter] public long? ElapsedMs { get; set; }
}
