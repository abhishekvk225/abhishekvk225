@typeparam T

<div data-testid="data-table" aria-busy="@(_loading ? "true" : "false")">
    @if (_result is null)
    {
        <SkeletonTable Rows="Math.Min(_pageSize, 6)" />
    }
    else if (!_result.IsSuccess)
    {
        <ErrorState Error="_result.Error" OnRetry="EventCallback.Factory.Create(this, ReloadAsync)" />
    }
    else if (_result.Value.Items.Count == 0)
    {
        @if (EmptyContent is not null)
        {
            @EmptyContent
        }
        else
        {
            <EmptyState Title="@(string.IsNullOrWhiteSpace(Search) ? "Nothing here yet" : "No results found")"
                        Message="@(string.IsNullOrWhiteSpace(Search) ? EmptyMessage : "Try a different search or clear the filters.")" />
        }
    }
    else
    {
        var data = _result.Value;
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Size="Size.Small" aria-label="Refreshing" />
        }

        <div class="nv-table-wrap">
            <table class="nv-table @(Dense ? "nv-dense" : "")" aria-label="@Caption">
                <thead>
                    <tr>
                        @foreach (var col in Columns)
                        {
                            <th scope="col" aria-sort="@AriaSort(col)" style="@(col.Numeric ? "text-align:right" : null)">
                                @if (col.SortKey is not null)
                                {
                                    <button type="button" class="nv-th-btn" @onclick="() => SortAsync(col)">
                                        @col.Header
                                        <MudIcon Icon="@SortIcon(col)" Size="Size.Small" />
                                    </button>
                                }
                                else
                                {
                                    @col.Header
                                }
                            </th>
                        }
                        @if (RowActions is not null)
                        {
                            <th scope="col"><span class="nv-sr">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in data.Items)
                    {
                        <tr>
                            @foreach (var col in Columns)
                            {
                                <td style="@(col.Numeric ? "text-align:right;font-variant-numeric:tabular-nums" : null)">@RenderCell(col, item)</td>
                            }
                            @if (RowActions is not null)
                            {
                                <td style="text-align:right; white-space:nowrap">@RowActions(item)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="nv-cards" role="list" aria-label="@Caption">
            @foreach (var item in data.Items)
            {
                <div class="nv-row-card" role="listitem">
                    <dl>
                        @foreach (var col in Columns)
                        {
                            <dt>@col.Header</dt>
                            <dd>@RenderCell(col, item)</dd>
                        }
                    </dl>
                    @if (RowActions is not null)
                    {
                        <div class="mt-2 d-flex justify-end">@RowActions(item)</div>
                    }
                </div>
            }
        </div>

        <div class="d-flex flex-wrap align-center justify-space-between pa-3" style="gap: var(--nv-space-3);">
            <MudText Class="nv-muted" Typo="Typo.body2" data-testid="range-text">@RangeText(data)</MudText>
            <div class="d-flex align-center" style="gap: var(--nv-space-2);">
                <MudSelect T="int" Value="_pageSize" ValueChanged="PageSizeChangedAsync" Label="Rows per page" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width: 120px;">
                    @foreach (var size in PageSizeOptions)
                    {
                        <MudSelectItem T="int" Value="size">@size</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" aria-label="Previous page" Disabled="@(data.Page <= 1 || _loading)" OnClick="PreviousAsync" data-testid="prev-page" />
                <MudText Typo="Typo.body2" aria-live="polite">Page @data.Page of @Math.Max(1, data.TotalPages)</MudText>
                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" aria-label="Next page" Disabled="@(data.Page >= data.TotalPages || _loading)" OnClick="NextAsync" data-testid="next-page" />
            </div>
        </div>
    }
</div>

@code {
    private ApiResult<PagedResult<T>>? _result;
    private bool _loading;
    private int _page = 1;
    private int _pageSize;
    private string? _sort;
    private string? _lastSearch;
    private bool _firstLoadDone;
    private int _requestId;

    /// <summary>Server-side data source. The table never holds more than one page.</summary>
    [Parameter, EditorRequired] public Func<PageRequest, Task<ApiResult<PagedResult<T>>>> LoadData { get; set; } = default!;

    [Parameter, EditorRequired] public IReadOnlyList<DataColumn<T>> Columns { get; set; } = [];

    /// <summary>Accessible name of the table.</summary>
    [Parameter] public string Caption { get; set; } = "Data";

    [Parameter] public int PageSize { get; set; } = 25;

    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 25, 50];

    /// <summary>Search text from a <see cref="FilterBar"/>. Changing it resets to page 1 and reloads.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Initial sort, e.g. <c>createdAt:desc</c>.</summary>
    [Parameter] public string? DefaultSort { get; set; }

    [Parameter] public bool Dense { get; set; }

    [Parameter] public string? EmptyMessage { get; set; }

    [Parameter] public RenderFragment? EmptyContent { get; set; }

    [Parameter] public RenderFragment<T>? RowActions { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!_firstLoadDone)
        {
            _firstLoadDone = true;
            _pageSize = PageSize;
            _sort = DefaultSort;
            _lastSearch = Search;
            await LoadAsync();
            return;
        }

        if (!string.Equals(_lastSearch, Search, StringComparison.Ordinal))
        {
            _lastSearch = Search;
            _page = 1;
            await LoadAsync();
        }
    }

    /// <summary>Reloads the current page (after a mutation, or from the error state's retry).</summary>
    public Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var id = ++_requestId;
        _loading = true;
        StateHasChanged();

        ApiResult<PagedResult<T>> result;
        try
        {
            result = await LoadData(new PageRequest { Page = _page, PageSize = _pageSize, Sort = _sort, Search = _lastSearch }.Normalize());
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            result = ApiResult<PagedResult<T>>.Fail(ApiError.Unexpected());
        }

        if (id != _requestId)
        {
            return; // a newer request superseded this one
        }

        _result = result;
        _loading = false;
    }

    private Task PreviousAsync() => GoToAsync(_page - 1);

    private Task NextAsync() => GoToAsync(_page + 1);

    private Task GoToAsync(int page)
    {
        _page = Math.Max(1, page);
        return LoadAsync();
    }

    private Task PageSizeChangedAsync(int size)
    {
        _pageSize = size;
        _page = 1;
        return LoadAsync();
    }

    private Task SortAsync(DataColumn<T> col)
    {
        var key = col.SortKey!;
        var current = _sort?.Split(':');
        if (current is { Length: > 0 } && string.Equals(current[0], key, StringComparison.OrdinalIgnoreCase))
        {
            var dir = current.Length > 1 && current[1].Equals("asc", StringComparison.OrdinalIgnoreCase) ? "desc" : "asc";
            _sort = $"{key}:{dir}";
        }
        else
        {
            _sort = $"{key}:asc";
        }

        _page = 1;
        return LoadAsync();
    }

    private string AriaSort(DataColumn<T> col)
    {
        if (col.SortKey is null || _sort is null)
        {
            return "none";
        }

        var parts = _sort.Split(':');
        if (!string.Equals(parts[0], col.SortKey, StringComparison.OrdinalIgnoreCase))
        {
            return "none";
        }

        return parts.Length > 1 && parts[1].Equals("desc", StringComparison.OrdinalIgnoreCase) ? "descending" : "ascending";
    }

    private string SortIcon(DataColumn<T> col) => AriaSort(col) switch
    {
        "ascending" => Icons.Material.Filled.ArrowUpward,
        "descending" => Icons.Material.Filled.ArrowDownward,
        _ => Icons.Material.Filled.UnfoldMore,
    };

    private RenderFragment RenderCell(DataColumn<T> col, T item) => col.Template is not null
        ? col.Template(item)
        : builder => builder.AddContent(0, col.Value?.Invoke(item));

    private static string RangeText(PagedResult<T> data)
    {
        var from = (data.Page - 1) * data.PageSize + 1;
        var to = Math.Min(data.Page * data.PageSize, data.TotalCount);
        return $"Showing {from}–{to} of {data.TotalCount}";
    }
}
