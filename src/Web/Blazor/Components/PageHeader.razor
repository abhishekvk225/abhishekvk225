<header class="d-flex flex-wrap align-center justify-space-between mb-6" style="gap: var(--nv-space-4);">
    <div style="min-width: 0;">
        @if (Breadcrumbs is { Count: > 0 })
        {
            <MudBreadcrumbs Items="Breadcrumbs" Class="pa-0 mb-1" />
        }
        <MudText Typo="Typo.h2" HtmlTag="h1">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body1" Class="nv-muted mt-1">@Subtitle</MudText>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="d-flex flex-wrap align-center" style="gap: var(--nv-space-2);">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public List<BreadcrumbItem>? Breadcrumbs { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }
}
