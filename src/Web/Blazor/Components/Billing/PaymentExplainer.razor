<MudPaper Class="nv-card nv-card-pad" Elevation="0" data-testid="payment-explainer">
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="mb-3">How paying works</MudText>
    <ol class="nv-steps">
        <li>
            <div>
                <strong>You pay on a secure page.</strong>
                <MudText Typo="Typo.body2" Class="nv-muted">When you press Buy, we send you to the secure payment page of our payment partner.</MudText>
            </div>
        </li>
        <li>
            <div>
                <strong>Your credits arrive by themselves.</strong>
                <MudText Typo="Typo.body2" Class="nv-muted">After you pay they are added to your account automatically, usually within a minute. You do not need to do anything.</MudText>
            </div>
        </li>
        <li>
            <div>
                <strong>We never see your card.</strong>
                <MudText Typo="Typo.body2" Class="nv-muted">Card details go straight to our payment partner. NexaVerify never receives or stores them. Your invoice is available under Orders &amp; invoices.</MudText>
            </div>
        </li>
    </ol>
</MudPaper>
