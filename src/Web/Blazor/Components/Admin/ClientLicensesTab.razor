@using NexaVerify.Contracts.Licensing
@inject ILicensingApiClient Api
@inject IDialogService Dialogs
@inject IAppSnackbar Snackbar

<MudPaper Class="nv-card nv-card-pad mb-4" Elevation="0">
    <div class="d-flex flex-wrap align-center justify-space-between mb-3" style="gap: var(--nv-space-3);">
        <MudText Typo="Typo.h5" HtmlTag="h2">Licenses</MudText>
        <Can Permission="@WebPermissions.LicensesCreate">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="IssueAsync" data-testid="issue-license">Issue license</MudButton>
        </Can>
    </div>
    <LicenseTable @ref="_table" ClientId="ClientId" ShowClient="false" Caption="Licenses of this client" PageSize="10" EmptyMessage="This client has no license yet." />
</MudPaper>

<MudPaper Class="nv-card nv-card-pad" Elevation="0">
    <div class="d-flex flex-wrap align-center justify-space-between mb-3" style="gap: var(--nv-space-3);">
        <MudText Typo="Typo.h5" HtmlTag="h2">Prices for this client</MudText>
        <Can Permission="@WebPermissions.LicensesCostRules">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Toll" OnClick="SetRuleAsync">Set a price</MudButton>
        </Can>
    </div>
    <CostRuleList Result="_rules" OnRetry="LoadRulesAsync" Caption="Prices for this client" EmptyMessage="This client pays the standard prices." />
</MudPaper>

@code {
    private LicenseTable? _table;
    private ApiResult<IReadOnlyList<CostRuleDto>>? _rules;

    [Parameter, EditorRequired] public Guid ClientId { get; set; }

    protected override Task OnInitializedAsync() => LoadRulesAsync();

    private async Task LoadRulesAsync()
    {
        _rules = null;
        _rules = await Api.ListClientCostRulesAsync(ClientId);
    }

    private async Task IssueAsync()
    {
        var plans = await Api.ListPlansAsync();
        var form = new IssueLicenseForm();
        var saved = await Dialogs.ShowFormAsync(
            "Issue a license",
            form,
            m => @<LicenseFields Model="m" Plans="@(plans.IsSuccess ? plans.Value.Where(p => p.IsActive).ToList() : [])" />,
            async m => (await Api.CreateAsync(ClientId, m.ToRequest())).ToFormError(),
            "Issue license");
        if (saved is not null)
        {
            Snackbar.Success("The license was issued.");
            if (_table is not null)
            {
                await _table.ReloadAsync();
            }
        }
    }

    private async Task SetRuleAsync()
    {
        var form = new CostRuleForm();
        var saved = await Dialogs.ShowFormAsync(
            "Set a price for this client",
            form,
            m => @<CostRuleFields Model="m" />,
            async m => (await Api.SetClientCostRuleAsync(ClientId, m.ToRequest())).ToFormError(),
            "Save price");
        if (saved is not null)
        {
            Snackbar.Success("The price was saved.");
            await LoadRulesAsync();
        }
    }
}
