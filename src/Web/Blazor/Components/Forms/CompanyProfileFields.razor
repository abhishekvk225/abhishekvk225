<MudGrid Spacing="2" data-testid="company-fields">
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.Name" For="() => Model.Name" Label="Company name" Variant="Variant.Outlined" Immediate="true" MaxLength="150" /></MudItem>
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.LegalName" For="() => Model.LegalName" Label="Legal name (optional)" Variant="Variant.Outlined" Immediate="true" MaxLength="200" /></MudItem>
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.ContactEmail" For="() => Model.ContactEmail" Label="Contact email" InputType="InputType.Email" Variant="Variant.Outlined" Immediate="true" MaxLength="256" /></MudItem>
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.ContactPhone" For="() => Model.ContactPhone" Label="Phone (optional)" InputType="InputType.Telephone" Variant="Variant.Outlined" Immediate="true" MaxLength="40" /></MudItem>
    <MudItem xs="12"><MudTextField T="string" @bind-Value="Model.AddressLine1" For="() => Model.AddressLine1" Label="Address (optional)" Variant="Variant.Outlined" Immediate="true" MaxLength="150" /></MudItem>
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.City" For="() => Model.City" Label="City (optional)" Variant="Variant.Outlined" Immediate="true" MaxLength="100" /></MudItem>
    <MudItem xs="6" sm="3"><MudTextField T="string" @bind-Value="Model.PostalCode" For="() => Model.PostalCode" Label="Postcode" Variant="Variant.Outlined" Immediate="true" MaxLength="20" /></MudItem>
    <MudItem xs="6" sm="3"><MudTextField T="string" @bind-Value="Model.Country" For="() => Model.Country" Label="Country code" Variant="Variant.Outlined" Immediate="true" MaxLength="2" HelperText="e.g. GB" /></MudItem>
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.Website" For="() => Model.Website" Label="Website (optional)" InputType="InputType.Url" Variant="Variant.Outlined" Immediate="true" MaxLength="200" HelperText="https://…" /></MudItem>
    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="Model.TimeZone" For="() => Model.TimeZone" Label="Time zone" Variant="Variant.Outlined" Immediate="true" MaxLength="64" HelperText="e.g. Europe/London or UTC" /></MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public CompanyProfileForm Model { get; set; } = default!;
}
