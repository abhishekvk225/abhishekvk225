@inject IClipboardService Clipboard

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" HtmlTag="h2">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (_consumed || _secret is null)
        {
            <MudAlert Severity="Severity.Info" Dense="true" data-testid="secret-hidden">For your security the secret is no longer shown.</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                @(Description ?? "Copy this now. You will not be able to see it again.")
            </MudAlert>
            <div class="nv-secret" data-testid="secret-value" tabindex="0" aria-label="Secret value">@_secret</div>
            <div class="d-flex align-center mt-2" style="gap: var(--nv-space-2);">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@(_copied ? Icons.Material.Filled.Check : Icons.Material.Outlined.ContentCopy)" OnClick="CopyAsync" data-testid="secret-copy">
                    @(_copied ? "Copied" : "Copy")
                </MudButton>
                <span class="nv-sr" role="status" aria-live="polite">@(_copied ? "Copied to clipboard" : string.Empty)</span>
                @if (_copyFailed)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">Copy was blocked by the browser. Select the text and copy it manually.</MudText>
                }
            </div>
            <MudCheckBox T="bool" @bind-Value="_stored" Label="I have stored it somewhere safe" Class="mt-3" data-testid="secret-stored" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_stored && !_consumed)" OnClick="Done" data-testid="secret-done">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string? _secret;
    private bool _consumed;
    private bool _stored;
    private bool _copied;
    private bool _copyFailed;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string Title { get; set; } = "Save your secret";

    [Parameter] public string? Description { get; set; }

    /// <summary>The secret is captured once; later parameter changes are ignored and it is dropped after confirmation.</summary>
    [Parameter] public string? Secret { get; set; }

    private bool _captured;

    protected override void OnParametersSet()
    {
        if (!_captured)
        {
            _captured = true;
            _secret = Secret;
        }
    }

    private async Task CopyAsync()
    {
        if (_secret is null)
        {
            return;
        }

        _copied = await Clipboard.CopyAsync(_secret);
        _copyFailed = !_copied;
    }

    private void Done()
    {
        _secret = null;
        _consumed = true;
        MudDialog.Close(DialogResult.Ok(true));
    }
}
