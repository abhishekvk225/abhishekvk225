@using System.Linq.Expressions

@* A password box with the policy written next to it and a strength hint that the page script fills in as people type. Advisory only. *@
<TextField Id="@Id" Label="@Label" Type="password" Autocomplete="new-password" Required="true" MaxLength="128" Value="@Value" ValueChanged="ValueChanged"
           ValueExpression="ValueExpression" HintText="@HintText">
    @if (ShowStrength)
    {
        <div class="mk-strength" data-mk-strength-for="@Id" data-testid="password-strength">
            <div class="mk-strength-bar" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            <p class="mk-strength-label" role="status" aria-live="polite">Strength: <span data-mk-strength-text>Not started</span></p>
        </div>
    }
</TextField>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter] public bool ShowStrength { get; set; }

    [Parameter] public string? HintText { get; set; }
}
