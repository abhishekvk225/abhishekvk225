@* A product-screenshot-like mock of the client dashboard, built from HTML and CSS only. The numbers are made up for illustration. *@
<figure class="mk-mock" data-testid="product-mock">
    <div class="mk-mock-window" aria-hidden="true">
        <div class="mk-mock-bar"><span></span><span></span><span></span><em>Dashboard</em></div>
        <div class="mk-mock-body">
            <div class="mk-mock-side">
                <b></b><i class="on"></i><i></i><i></i><i></i><i></i>
            </div>
            <div class="mk-mock-main">
                <div class="mk-mock-stats">
                    <div><small>Checks today</small><strong>1,284</strong></div>
                    <div><small>Match rate</small><strong>97.6%</strong></div>
                    <div><small>People registered</small><strong>3,902</strong></div>
                </div>
                <div class="mk-mock-grid">
                    <div class="mk-mock-chart">
                        <small>Checks per day</small>
                        <div class="mk-mock-bars">
                            <span style="height:38%"></span><span style="height:52%"></span><span style="height:46%"></span><span style="height:64%"></span>
                            <span style="height:58%"></span><span style="height:78%"></span><span style="height:70%"></span><span style="height:92%"></span>
                        </div>
                    </div>
                    <div class="mk-mock-gauge">
                        <small>Credits left</small>
                        <div class="mk-mock-ring"><strong>72%</strong></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <figcaption class="mk-caption">Illustration of the client dashboard. Figures are examples.</figcaption>
</figure>
