@* Small stroke icon set drawn inline (no icon font, no external request). Decorative unless Label is given. *@
@if (string.IsNullOrEmpty(Label))
{
    <svg class="mk-icon" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@Paths</svg>
}
else
{
    <svg class="mk-icon" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="@Label" focusable="false">@Paths</svg>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public int Size { get; set; } = 24;

    [Parameter] public string? Label { get; set; }

    private RenderFragment Paths => __builder =>
    {
        switch (Name)
        {
            case "scan":
                <path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2" />
                <circle cx="12" cy="11" r="3" /><path d="M7.5 17c.8-2 2.5-3 4.5-3s3.700 1 4.500 3" />
                break;
            case "check-person":
                <circle cx="10" cy="8" r="3.500" /><path d="M3.500 20c.6-3.500 3.200-5.500 6.500-5.500 1.200 0 2.300.3 3.200.8" /><path d="m15 18 2 2 4-4.500" />
                break;
            case "search-person":
                <circle cx="10" cy="8" r="3.500" /><path d="M3.500 20c.5-3 2.500-5 5-5.300" /><circle cx="16.500" cy="16.500" r="3" /><path d="m21 21-2.400-2.400" />
                break;
            case "user-plus":
                <circle cx="9" cy="8" r="3.500" /><path d="M2.500 20c.6-3.500 3.200-5.500 6.500-5.500s5.900 2 6.500 5.500M19 8v6M16 11h6" />
                break;
            case "key":
                <circle cx="8" cy="15" r="4" /><path d="m11 12 8-8M16 7l3 3M14 9l2 2" />
                break;
            case "webhook":
                <path d="M12 8a3 3 0 1 0-2.600-4.500M9 13l-3.500 6M7 19a2.500 2.500 0 1 0 0-.1M14 17h5.500M19.500 17a2.500 2.500 0 1 0 0 .1M9.500 8 6 14" />
                <circle cx="6" cy="14" r="2.500" />
                break;
            case "chart":
                <path d="M4 20V10M10 20V4M16 20v-8M22 20H2" />
                break;
            case "download":
                <path d="M12 4v11M7 11l5 5 5-5M5 20h14" />
                break;
            case "users":
                <circle cx="9" cy="8" r="3.500" /><path d="M2.500 20c.6-3.500 3.200-5.500 6.500-5.500s5.900 2 6.500 5.500" /><path d="M16 4.500a3.500 3.500 0 0 1 0 7M18.500 15c1.700.8 2.800 2.500 3 5" />
                break;
            case "shield":
                <path d="M12 3 4.500 6v5.500c0 4.500 3 8 7.500 9.500 4.500-1.500 7.500-5 7.500-9.500V6L12 3Z" /><path d="m9 12 2.200 2.200L15.500 10" />
                break;
            case "lock":
                <rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3M12 15v2" />
                break;
            case "phone-lock":
                <rect x="6" y="2.500" width="12" height="19" rx="2.500" /><path d="M10 18.500h4M12 7.500v3M10.500 10.500h3" />
                break;
            case "list":
                <path d="M9 6h11M9 12h11M9 18h11M4.500 6h.01M4.500 12h.01M4.500 18h.01" />
                break;
            case "trash":
                <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3" />
                break;
            case "globe":
                <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.500 2.700 3.800 5.700 3.800 9S14.500 18.300 12 21c-2.500-2.700-3.800-5.700-3.800-9S9.500 5.700 12 3Z" />
                break;
            case "code":
                <path d="m8 8-4.500 4L8 16M16 8l4.500 4L16 16M13.500 5 10.500 19" />
                break;
            case "clock":
                <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3.500 2" />
                break;
            case "building":
                <rect x="4" y="3" width="11" height="18" rx="1.500" /><path d="M15 9h4a1 1 0 0 1 1 1v11M8 7.500h3M8 11.500h3M8 15.500h3M18 13h.01M18 17h.01" />
                break;
            case "door":
                <path d="M6 21V4.500A1.500 1.500 0 0 1 7.500 3h9A1.500 1.500 0 0 1 18 4.500V21M3 21h18M14.500 12h.01" />
                break;
            case "id-card":
                <rect x="3" y="5" width="18" height="14" rx="2.500" /><circle cx="9" cy="11" r="2" /><path d="M5.800 16c.4-1.500 1.600-2.300 3.200-2.300s2.800.8 3.200 2.300M15 10h3M15 13.500h3" />
                break;
            case "visitor":
                <circle cx="12" cy="7.500" r="3.500" /><path d="M5 21v-1.500A5.500 5.500 0 0 1 10.500 14h3a5.500 5.500 0 0 1 5.500 5.500V21M12 17v2" />
                break;
            case "mail":
                <rect x="3" y="5" width="18" height="14" rx="2.500" /><path d="m4 7.500 8 5.500 8-5.500" />
                break;
            case "check":
                <path d="m5 12.500 4.500 4.500L19 7.500" />
                break;
            case "arrow-right":
                <path d="M5 12h14M13 6l6 6-6 6" />
                break;
            case "menu":
                <path d="M4 7h16M4 12h16M4 17h16" />
                break;
            case "close":
                <path d="m6 6 12 12M18 6 6 18" />
                break;
            case "sun":
                <circle cx="12" cy="12" r="4" /><path d="M12 2.500v2M12 19.500v2M2.500 12h2M19.500 12h2M5.300 5.300l1.400 1.400M17.300 17.300l1.400 1.400M5.300 18.700l1.400-1.400M17.300 6.700l1.400-1.400" />
                break;
            case "moon":
                <path d="M20 14.500A8.500 8.500 0 0 1 9.500 4 8.500 8.500 0 1 0 20 14.500Z" />
                break;
            case "info":
                <circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" />
                break;
            case "alert":
                <path d="M12 3.500 2.500 20h19L12 3.500ZM12 10v4.500M12 17.500h.01" />
                break;
            case "link":
                <path d="M10 14a4 4 0 0 0 5.700 0l3-3a4 4 0 0 0-5.700-5.700l-1 1M14 10a4 4 0 0 0-5.700 0l-3 3a4 4 0 0 0 5.700 5.700l1-1" />
                break;
            default:
                <circle cx="12" cy="12" r="9" />
                break;
        }
    };
}
