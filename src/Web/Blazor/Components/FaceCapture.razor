@implements IAsyncDisposable
@inject IJSRuntime Js

<div data-testid="face-capture">
    <MudTabs Elevation="0" Rounded="true" ActivePanelIndexChanged="OnTabChangedAsync" TabPanelsClass="pt-4" KeepPanelsAlive="true">
        <MudTabPanel Text="Use camera" Icon="@Icons.Material.Outlined.PhotoCamera">
            @if (_hasPhoto && _source == Source.Camera)
            {
                @if (_preview is not null)
                {
                    <img class="nv-preview" src="@_preview" alt="Preview of the captured photo" data-testid="capture-preview" />
                }
                else
                {
                    <MudText Typo="Typo.body2" data-testid="capture-ready">@PhotoDescription</MudText>
                }
                <div class="d-flex flex-wrap mt-3" style="gap: var(--nv-space-2);">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UseAsync" data-testid="capture-use">Use this photo</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="RetakeAsync" data-testid="capture-retake">Retake</MudButton>
                </div>
            }
            else
            {
                <video @ref="_video" class="nv-video" playsinline muted aria-label="Camera preview" style="@(_cameraOn ? null : "display:none")"></video>
                @if (!_cameraOn)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Videocam" OnClick="StartCameraAsync" data-testid="camera-start">Turn on camera</MudButton>
                }
                else
                {
                    <div class="d-flex flex-wrap mt-3" style="gap: var(--nv-space-2);">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.PhotoCamera" OnClick="CaptureAsync" data-testid="camera-capture">Take photo</MudButton>
                        <MudButton Variant="Variant.Text" OnClick="StopCameraAsync">Turn off camera</MudButton>
                    </div>
                }
            }
            @if (_cameraProblem is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" data-testid="camera-problem">@_cameraProblem</MudAlert>
            }
        </MudTabPanel>
        <MudTabPanel Text="Upload a photo" Icon="@Icons.Material.Outlined.UploadFile">
            <MudText Typo="Typo.body2" Class="nv-muted mb-2">@FaceLimits.TypesText, up to @FaceLimits.MaxImageMegabytes MB.</MudText>
            <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mud-ripple" style="cursor:pointer; padding: 6px 16px;">
                Choose a photo
                <InputFile OnChange="OnFileAsync" accept="@string.Join(',', FaceLimits.AllowedImageTypes)" class="nv-sr" data-testid="capture-file" />
            </label>
            @if (_uploadProblem is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" data-testid="upload-problem">@_uploadProblem</MudAlert>
            }
            @if (_hasPhoto && _source == Source.Upload)
            {
                @if (_preview is not null)
                {
                    <img class="nv-preview mt-3" src="@_preview" alt="Preview of the chosen photo" />
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mt-3" data-testid="upload-ready">@PhotoDescription</MudText>
                }
                <div class="d-flex flex-wrap mt-3" style="gap: var(--nv-space-2);">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UseAsync" data-testid="capture-use">Use this photo</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="RetakeAsync" data-testid="capture-retake">Choose another</MudButton>
                </div>
            }
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    private enum Source
    {
        Camera,
        Upload,
    }

    private ElementReference _video;
    private IJSObjectReference? _module;
    private bool _cameraOn;
    private string? _cameraProblem;
    private string? _uploadProblem;
    private string? _preview;
    private byte[]? _bytes;
    private string _contentType = "image/jpeg";
    private bool _hasPhoto;
    private long _photoSize;
    private Source _source;

    private const int PreviewLimitBytes = 1024 * 1024;

    /// <summary>Largest accepted photo (matches the API default, docs/03 section 5).</summary>
    [Parameter] public long MaxBytes { get; set; } = FaceLimits.MaxImageBytes;

    /// <summary>Raised when the user confirms a photo. The component forgets its copy straight afterwards.</summary>
    [Parameter] public EventCallback<CapturedImage> OnCaptured { get; set; }

    private async Task<IJSObjectReference?> ModuleAsync()
    {
        if (_module is not null)
        {
            return _module;
        }

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/face-capture.js");
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
        {
            _cameraProblem = "The camera is not available in this browser. Upload a photo instead.";
        }

        return _module;
    }

    private async Task StartCameraAsync()
    {
        _cameraProblem = null;
        var module = await ModuleAsync();
        if (module is null)
        {
            return;
        }

        _cameraOn = true;
        StateHasChanged();
        await Task.Yield();

        string code;
        try
        {
            code = await module.InvokeAsync<string>("start", _video);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            code = "error";
        }

        if (code.Length > 0)
        {
            _cameraOn = false;
            _cameraProblem = code switch
            {
                "denied" => "Camera access was blocked. Allow the camera in your browser, or upload a photo instead.",
                "nodevice" => "No camera was found. Upload a photo instead.",
                "busy" => "The camera is being used by another app. Close it and try again, or upload a photo.",
                "unsupported" => "This browser cannot use the camera here. Upload a photo instead.",
                _ => "We could not start the camera. Upload a photo instead.",
            };
        }
    }

    private async Task StopCameraAsync()
    {
        _cameraOn = false;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _video);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                // The page is going away or the element is gone: nothing left to release.
            }
        }
    }

    private async Task CaptureAsync()
    {
        _cameraProblem = null;
        IJSStreamReference? frame = null;
        try
        {
            frame = await _module!.InvokeAsync<IJSStreamReference?>("captureStream", _video, 0.92);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            frame = null;
        }

        if (frame is null)
        {
            _cameraProblem = "We could not take the photo. Please try again.";
            return;
        }

        await using (frame)
        {
            // The size is known up front: refuse an oversized frame before reading a byte, and read in chunks into one exact-size buffer.
            if (frame.Length <= 0 || frame.Length > MaxBytes)
            {
                _cameraProblem = frame.Length > MaxBytes
                    ? $"The photo is too large (max {FaceLimits.MaxImageMegabytes} MB). Please try again."
                    : "We could not take the photo. Please try again.";
                return;
            }

            byte[] bytes;
            try
            {
                await using var stream = await frame.OpenReadStreamAsync(MaxBytes);
                bytes = new byte[(int)frame.Length];
                await stream.ReadExactlyAsync(bytes);
            }
            catch (Exception ex) when (ex is IOException or JSException or JSDisconnectedException or InvalidOperationException or EndOfStreamException)
            {
                _cameraProblem = "We could not take the photo. Please try again.";
                return;
            }

            await StopCameraAsync();
            Accept(bytes, "image/jpeg", Source.Camera);
        }
    }

    private async Task OnFileAsync(InputFileChangeEventArgs e)
    {
        _uploadProblem = null;
        var file = e.File;

        if (file.Size > MaxBytes)
        {
            _uploadProblem = $"That photo is too large. The limit is {FaceLimits.MaxImageMegabytes} MB.";
            return;
        }

        if (!FaceLimits.AllowedImageTypes.Contains(file.ContentType, StringComparer.OrdinalIgnoreCase))
        {
            _uploadProblem = $"Please choose a {FaceLimits.TypesText} photo.";
            return;
        }

        byte[]? bytes = null;
        try
        {
            // One exact-size buffer (no MemoryStream + ToArray copy).
            await using var stream = file.OpenReadStream(MaxBytes);
            bytes = new byte[file.Size];
            await stream.ReadExactlyAsync(bytes);

            var detected = ImageSniffer.Detect(bytes);
            if (detected is null)
            {
                Array.Clear(bytes);
                _uploadProblem = $"That file does not look like a valid photo. Please choose a {FaceLimits.TypesText} photo.";
                return;
            }

            Accept(bytes, detected, Source.Upload);
        }
        catch (Exception ex) when (ex is IOException or EndOfStreamException)
        {
            if (bytes is not null)
            {
                Array.Clear(bytes);
            }

            _uploadProblem = $"That photo is too large. The limit is {FaceLimits.MaxImageMegabytes} MB.";
        }
    }

    private void Accept(byte[] bytes, string contentType, Source source)
    {
        Wipe();
        _bytes = bytes;
        _contentType = contentType;
        _source = source;

        // A data-URI preview is a string several times the photo's size that travels to the browser in a render batch: only for small
        // photos. Larger ones show a short description instead.
        _preview = bytes.Length <= PreviewLimitBytes ? $"data:{contentType};base64,{Convert.ToBase64String(bytes)}" : null;
        _hasPhoto = true;
        _photoSize = bytes.Length;
    }

    private async Task UseAsync()
    {
        if (_bytes is null)
        {
            return;
        }

        // Ownership of the buffer passes to the caller, who clears it when done.
        var image = new CapturedImage(_bytes, _contentType, "upload" + ImageSniffer.ExtensionFor(_contentType));
        _bytes = null;
        _preview = null;
        _hasPhoto = false;
        await OnCaptured.InvokeAsync(image);
    }

    private async Task RetakeAsync()
    {
        Wipe();
        if (_source == Source.Camera)
        {
            await StartCameraAsync();
        }
    }

    private async Task OnTabChangedAsync(int index)
    {
        if (index != 0 && _cameraOn)
        {
            await StopCameraAsync();
        }
    }

    /// <summary>Drops the photo this component still holds, overwriting its bytes (best effort: the GC may have moved copies).</summary>
    private void Wipe()
    {
        if (_bytes is not null)
        {
            Array.Clear(_bytes);
        }

        _bytes = null;
        _preview = null;
        _hasPhoto = false;
    }

    private string PhotoDescription => $"Photo ready ({_photoSize / 1024.0 / 1024.0:0.0} MB).";

    public async ValueTask DisposeAsync()
    {
        Wipe();
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _video);
                await _module.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                // Circuit already gone; the browser releases the camera with the page.
            }
        }
    }
}
